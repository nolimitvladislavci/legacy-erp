
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<style>
  @page { margin: 15mm 15mm 20mm 15mm; size: A4; }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { font-family: 'DejaVu Sans', Arial, sans-serif; font-size: 10pt; color: #1a1a1a; }
  .header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:24pt; border-bottom:2pt solid #1e3a5f; padding-bottom:16pt; }
  .logo-area h1 { font-size:18pt; font-weight:700; color:#1e3a5f; }
  .logo-area .subtitle { font-size:7.5pt; color:#64748b; letter-spacing:2px; text-transform:uppercase; margin-top:2pt; }
  .issuer-info { text-align:right; font-size:8.5pt; color:#475569; line-height:1.6; }
  .invoice-meta { display:flex; justify-content:space-between; margin-bottom:20pt; }
  .invoice-title h2 { font-size:20pt; font-weight:700; color:#1e3a5f; }
  .invoice-title .number { font-size:11pt; color:#c9a84c; font-weight:600; margin-top:4pt; }
  .dates-box { text-align:right; }
  .date-row { display:flex; gap:12pt; justify-content:flex-end; margin-bottom:4pt; }
  .date-label { font-size:8pt; color:#64748b; width:110pt; text-align:right; }
  .date-val { font-size:8.5pt; font-weight:600; color:#0f172a; width:70pt; text-align:right; }
  .parties { display:flex; gap:20pt; margin-bottom:20pt; }
  .party-box { flex:1; background:#f8fafc; padding:12pt; border-left:3pt solid #c9a84c; }
  .party-label { font-size:7pt; text-transform:uppercase; letter-spacing:1px; color:#64748b; margin-bottom:6pt; }
  .party-name { font-size:10.5pt; font-weight:700; color:#0f172a; margin-bottom:4pt; }
  .party-detail { font-size:8.5pt; color:#475569; line-height:1.6; }
  table { width:100%; border-collapse:collapse; margin-bottom:16pt; }
  thead tr { background:#1e3a5f; color:white; }
  thead th { padding:7pt 8pt; font-size:8pt; text-transform:uppercase; letter-spacing:0.5px; text-align:left; }
  thead th:last-child, thead th:nth-child(3), thead th:nth-child(4) { text-align:right; }
  tbody tr { border-bottom:0.5pt solid #e2e8f0; }
  tbody tr:nth-child(even) { background:#f8fafc; }
  tbody td { padding:7pt 8pt; font-size:9pt; }
  tbody td:last-child, tbody td:nth-child(3), tbody td:nth-child(4) { text-align:right; }
  .totals { display:flex; justify-content:flex-end; margin-bottom:20pt; }
  .totals-table { width:220pt; }
  .totals-table tr td { padding:4pt 6pt; font-size:9pt; }
  .totals-table tr td:last-child { text-align:right; font-weight:600; }
  .totals-table .netto { background:#f1f5f9; }
  .totals-table .total-row td { background:#1e3a5f; color:white; font-size:11pt; font-weight:700; padding:7pt 6pt; }
  .payment-box { background:#f8fafc; padding:10pt; border:0.5pt solid #e2e8f0; margin-bottom:16pt; }
  .payment-box h4 { font-size:8pt; text-transform:uppercase; letter-spacing:1px; color:#64748b; margin-bottom:8pt; }
  .payment-grid { display:flex; gap:16pt; }
  .payment-col { flex:1; }
  .payment-row { display:flex; justify-content:space-between; margin-bottom:3pt; }
  .payment-label { font-size:8pt; color:#64748b; }
  .payment-val { font-size:8.5pt; font-weight:600; color:#0f172a; }
  .legal-box { font-size:7.5pt; color:#64748b; line-height:1.6; margin-bottom:16pt; }
  .note-box { background:#fffbeb; border-left:3pt solid #f59e0b; padding:8pt 12pt; margin-bottom:16pt; font-size:8.5pt; }
  .footer { position:fixed; bottom:0; left:0; right:0; text-align:center; font-size:7.5pt; color:#94a3b8; border-top:0.5pt solid #e2e8f0; padding:6pt 15mm; background:white; }
</style>
</head>
