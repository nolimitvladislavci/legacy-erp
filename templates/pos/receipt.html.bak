{% extends "pos/base_pos.html" %}
{% load i18n %}
{% block title %}Bon #{{ receipt.receipt_number }}{% endblock %}
{% block extra_css %}
<style>
.rl{display:grid;grid-template-columns:1fr 360px;height:calc(100vh - 44px);overflow:hidden}
.ip{overflow-y:auto;padding:1.25rem;border-right:1px solid var(--border);display:flex;flex-direction:column;gap:.75rem}
.rh{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:1rem 1.25rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.5rem}
.rh-title{font-weight:700;font-size:1rem}.rh-meta{font-size:.8rem;color:var(--muted)}
.it{width:100%;border-collapse:collapse}
.it th{text-align:left;padding:.5rem .6rem;font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);border-bottom:1px solid var(--border)}
.it td{padding:.65rem .6rem;border-bottom:1px solid rgba(255,255,255,.04);font-size:.85rem;vertical-align:middle}
.it tr:hover td{background:rgba(255,255,255,.02)}
.rm{background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.1rem;padding:.3rem .5rem;border-radius:4px;min-width:32px;min-height:32px}.rm:hover{color:var(--red);background:rgba(239,68,68,.1)}
.ai{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:1.25rem}
.ai-title{font-size:.75rem;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:.875rem}
.ai-label{font-size:.7rem;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);display:block;margin-bottom:.25rem}
.ai-input{background:var(--dark);border:1px solid var(--border);border-radius:5px;color:var(--text);padding:.5rem .7rem;font-size:.85rem;width:100%;font-family:inherit}
.ai-input:focus{outline:none;border-color:var(--gold)}
.fr2{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-bottom:.6rem}
.bc-bar{display:flex;gap:.5rem;margin-bottom:.75rem}.bc-bar input{flex:1}
.pp{display:flex;flex-direction:column;overflow:hidden}
.ts{padding:1.25rem;border-bottom:1px solid var(--border)}
.t-row{display:flex;justify-content:space-between;padding:.4rem 0;font-size:.875rem}
.t-lbl{color:var(--muted)}.t-val{font-weight:600}
.t-total{border-top:2px solid var(--border);margin-top:.5rem;padding-top:.75rem;font-size:1.25rem;font-weight:700}
.t-total .t-val{color:var(--gold);font-size:1.4rem}
.pay{padding:1.25rem;flex:1;overflow-y:auto}
.pay-title{font-size:.75rem;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:.875rem}
.mtabs{display:flex;gap:.4rem;margin-bottom:.875rem;flex-wrap:wrap}
.mtab{padding:.55rem 1rem;border-radius:5px;border:1px solid var(--border);background:transparent;color:var(--muted);font-size:.85rem;cursor:pointer;font-family:inherit;transition:all .2s;min-height:44px}
.mtab.active,.mtab:hover{border-color:var(--gold);color:var(--gold);background:rgba(201,168,76,.08)}
.change-box{background:rgba(76,175,125,.1);border:1px solid var(--green);border-radius:6px;padding:.75rem;text-align:center;margin-bottom:.875rem;display:none}
.change-box.show{display:block}
.change-lbl{font-size:.75rem;color:var(--muted)}.change-val{font-size:1.5rem;font-weight:700;color:var(--green)}
.ab{padding:1rem 1.25rem;border-top:1px solid var(--border);display:flex;gap:.5rem}
.ni{text-align:center;padding:2rem;color:var(--muted);border:2px dashed var(--border);border-radius:8px}

/* ── Touch-first buttons ── */
.btn-pay{width:100%;justify-content:center;font-size:1rem;padding:1rem;min-height:60px;font-weight:800;letter-spacing:.02em}
.btn-add-item{width:100%;justify-content:center;margin-top:.25rem;min-height:52px;font-size:.9rem}
.btn-cancel{width:100%;justify-content:center;min-height:48px}

/* ── Searchable autocomplete ── */
.ac-wrap{position:relative;margin-bottom:.75rem}
.ac-dropdown{position:absolute;top:100%;left:0;right:0;background:#1e293b;border:1px solid var(--gold);border-top:none;border-radius:0 0 8px 8px;max-height:240px;overflow-y:auto;z-index:200;display:none}
.ac-item{padding:.6rem .875rem;cursor:pointer;font-size:.85rem;border-bottom:1px solid rgba(255,255,255,.05);display:flex;justify-content:space-between;align-items:center}
.ac-item:hover,.ac-item.highlighted{background:rgba(201,168,76,.12);color:var(--gold)}
.ac-item-name{font-weight:500}.ac-item-meta{font-size:.72rem;color:var(--muted)}
.ac-item-price{font-weight:700;color:var(--gold);font-size:.85rem}
.ac-clear{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--muted);cursor:pointer;font-size:1rem;padding:4px}

/* ── Quick cash buttons ── */
.cash-quick{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:.6rem}
.cash-btn{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:var(--text);border-radius:6px;padding:.45rem .7rem;font-size:.78rem;cursor:pointer;font-weight:600;min-height:40px;transition:all .15s}
.cash-btn:hover{border-color:var(--gold);color:var(--gold)}

/* ── Spinner ── */
@keyframes spin{to{transform:rotate(360deg)}}
.spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite;vertical-align:middle}

/* ── Disabled state ── */
button[disabled]{opacity:.5;cursor:not-allowed}

/* Mobile responsive */
@media (max-width: 700px) {
  .rl{grid-template-columns:1fr;height:auto;min-height:100vh}
  .ip{border-right:none;border-bottom:1px solid var(--border);max-height:55vh;overflow-y:auto}
  .pp{max-height:45vh;overflow-y:auto}
  .btn-pay{position:sticky;bottom:0;z-index:10;width:100%;margin-top:.5rem}
  .ab{position:sticky;bottom:0;z-index:9;padding:.75rem 1rem}
}
</style>
{% endblock %}

{% block content %}
<div class="rl">
  <!-- LEFT: Items + Add form -->
  <div class="ip">
    <div class="rh">
      <div>
        <div class="rh-title">Bon #{{ receipt.receipt_number }}{% if receipt.table_number %} <span style="color:var(--muted);font-weight:400;font-size:.85rem">| Stol {{ receipt.table_number }}</span>{% endif %}</div>
        <div class="rh-meta">{{ receipt.session.terminal.name }} &mdash; {{ receipt.created_at|date:"d.m.Y H:i" }}{% if receipt.note %} &mdash; {{ receipt.note }}{% endif %}</div>
      </div>
      <div style="display:flex;align-items:center;gap:.5rem">
        <span class="badge badge-{{ receipt.status }}">{{ receipt.get_status_display }}</span>
        <a href="{% url 'pos:session_detail' receipt.session_id %}" class="btn btn-ghost btn-sm">{% trans "&larr; Smjena" %}</a>
        {% if receipt.status == "paid" %}
          <a href="{% url 'pos:receipt_pdf' receipt.id %}?format=thermal" class="btn btn-ghost btn-sm" target="_blank">{% trans "🖨 Thermal" %}</a>
          <a href="{% url 'pos:receipt_pdf' receipt.id %}?format=a4" class="btn btn-ghost btn-sm" target="_blank">{% trans "📄 A4" %}</a>
        {% endif %}
      </div>
    </div>

    {% if items %}
    <div style="overflow-x:auto;-webkit-overflow-scrolling:touch">
    <table class="it">
      <thead><tr><th>{% trans "Naziv" %}</th><th>{% trans "Kol" %}</th><th>{% trans "Cijena" %}</th><th>{% trans "PDV%" %}</th><th>{% trans "Ukupno" %}</th><th></th></tr></thead>
      <tbody>{% for item in items %}
      <tr>
        <td><div>{{ item.description }}</div>{% if item.barcode %}<div style="font-size:.72rem;color:var(--muted)">{{ item.barcode }}</div>{% endif %}</td>
        <td>{{ item.quantity|floatformat:"-2" }} {{ item.unit|default:"kom" }}</td>
        <td>&euro;{{ item.unit_price|floatformat:2 }}</td>
        <td>{{ item.tax_rate|floatformat:0 }}%</td>
        <td style="color:var(--gold);font-weight:600">&euro;{{ item.total_price|floatformat:2 }}</td>
        <td>{% if receipt.status == "open" %}
          <form method="post" action="{% url 'pos:remove_item' receipt.id item.id %}" style="display:inline">{% csrf_token %}
            <button type="submit" class="rm" title="{% trans "Ukloni" %}">{% trans "&times;" %}</button>
          </form>
        {% endif %}</td>
      </tr>
      {% endfor %}</tbody>
    </table>
    </div><!-- /scroll -->
    {% else %}<div class="ni">{% trans "Nema stavki. Dodajte artikle ispod." %}</div>{% endif %}

    {% if receipt.status == "open" %}
    <div class="ai">
      <div class="ai-title">{% trans "Dodaj stavku" %}</div>

      <!-- Brze tipke — top artikli -->
      {% if quick_items %}
      <div style="margin-bottom:.75rem">
        <div style="font-size:.75rem;font-weight:600;color:var(--muted);margin-bottom:.4rem;text-transform:uppercase;letter-spacing:.5px">Brze tipke</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:5px">
          {% for qi in quick_items %}
          <button type="button" class="qk-btn" onclick="quickAdd({{qi.id}})"
                  style="background:var(--card);border:1px solid var(--border);border-radius:6px;padding:6px 4px;
                         font-size:.72rem;font-weight:600;color:var(--text);cursor:pointer;text-align:center;
                         line-height:1.2;min-height:38px;transition:all .12s;font-family:inherit"
                  onmouseover="this.style.borderColor='var(--gold)';this.style.color='var(--gold)'"
                  onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text)'"
                  title="{{qi.name}} — €{{qi.unit_price|floatformat:2}}">
            <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ qi.name|truncatechars:18 }}</div>
            <div style="color:var(--gold);font-size:.68rem;margin-top:2px">€{{ qi.unit_price|floatformat:2 }}</div>
          </button>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      <!-- Barcode scanner -->
      <div class="bc-bar">
        <input type="text" class="ai-input" id="bcIn" placeholder="{% trans "Skenirajte barkod..." %}" autocomplete="off">
        <button class="btn btn-ghost btn-sm" onclick="lookupBC()">{% trans "Traži" %}</button>
        <button type="button" class="btn btn-ghost btn-sm" onclick="openCamScanner()" title="Skeniraj kamerom"
                style="font-size:1.1rem;padding:4px 10px">📷</button>
      </div>

      <!-- Searchable autocomplete -->
      <label class="ai-label">{% trans "Pretraži iz zalihe" %}</label>
      <div class="ac-wrap">
        <input type="text" class="ai-input" id="acInput" placeholder="{% trans "Upišite naziv ili SKU artikla..." %}" autocomplete="off">
        <button class="ac-clear" id="acClear" onclick="clearAC()" style="display:none">{% trans "&times;" %}</button>
        <div class="ac-dropdown" id="acDropdown"></div>
      </div>

      <form method="post" action="{% url 'pos:add_item' receipt.id %}" id="aiForm" onsubmit="guardSubmit(this,'Dodajem...')">
        {% csrf_token %}
        <input type="hidden" name="inventory_item_id" id="inv_id">
        <input type="hidden" name="barcode" id="bc_field">
        <div style="margin-bottom:.6rem">
          <label class="ai-label">{% trans "Naziv *" %}</label>
          <input type="text" name="description" id="desc_f" class="ai-input" placeholder="{% trans "Naziv artikla" %}" required>
        </div>
        <div class="fr2">
          <div><label class="ai-label">{% trans "Količina" %}</label><input type="number" name="quantity" id="qty_f" class="ai-input" value="1" min="0.001" step="0.001" inputmode="decimal"></div>
          <div><label class="ai-label">{% trans "Cijena (&euro;)" %}</label><input type="number" name="unit_price" id="price_f" class="ai-input" value="0" min="0" step="0.01" inputmode="decimal"></div>
        </div>
        <div class="fr2">
          <div><label class="ai-label">{% trans "PDV (%)" %}</label><input type="number" name="tax_rate" id="tax_f" class="ai-input" value="25" min="0" step="0.01" inputmode="decimal"></div>
          <div><label class="ai-label">{% trans "Popust (%)" %}</label><input type="number" name="discount_percent" class="ai-input" value="0" min="0" max="100" step="0.01"></div>
        </div>
        <button type="submit" id="addBtn" class="btn btn-gold btn-add-item">{% trans "+ Dodaj na bon" %}</button>
        <button type="button" class="btn btn-ghost" onclick="openPfandReturn()" style="margin-top:.4rem;width:100%;font-size:.8rem">&#8617; {% trans "Povratna ambalaza" %}</button>
      </form>
    </div>
    {% endif %}
  </div>

  <!-- RIGHT: Totals + Payment -->
  <div class="pp">
    <div class="ts">
      <div style="font-weight:700;margin-bottom:.875rem">{% trans "Iznosi" %}</div>
      <div class="t-row"><div class="t-lbl">{% trans "Neto (bez PDV)" %}</div><div class="t-val">&euro;{{ receipt.subtotal|floatformat:2 }}</div></div>
      <div class="t-row"><div class="t-lbl">{% trans "PDV" %}</div><div class="t-val">&euro;{{ receipt.tax_amount|floatformat:2 }}</div></div>
      {% if receipt.discount %}<div class="t-row"><div class="t-lbl">{% trans "Popust" %}</div><div class="t-val" style="color:var(--red)">-&euro;{{ receipt.discount|floatformat:2 }}</div></div>{% endif %}
      <div class="t-row t-total"><div class="t-lbl">{% trans "UKUPNO" %}</div><div class="t-val">&euro;{{ receipt.total|floatformat:2 }}</div></div>
    </div>

    {% if receipt.status == "open" or receipt.status == "ISSUED" %}
    <div class="pay">
      <div class="pay-title">{% trans "Naplata" %}</div>
      <form method="post" action="{% url 'pos:process_payment' receipt.id %}" id="payForm"
            onsubmit="guardSubmit(this,'Obrađujem...',true)">
        {% csrf_token %}
        <input type="hidden" name="payment_method" id="payMethod" value="CASH">

        <!-- Payment method tabs -->
        <div class="mtabs">
          {% for val, lbl in payment_methods %}
          <button type="button" class="mtab {% if val == 'CASH' %}active{% endif %}"
                  onclick="setM('{{ val }}',this)">{{ lbl }}</button>
          {% endfor %}
        </div>

        <!-- Amount received -->
        <label class="ai-label" style="margin-bottom:.4rem">{% trans "Primljeno (&euro;)" %}</label>
        <input type="number" name="amount_paid" id="amtPaid" class="ai-input"
               value="{{ receipt.total|floatformat:2 }}" min="0" step="0.01"
               oninput="calcChg()" style="font-size:1.2rem;font-weight:700;margin-bottom:.5rem">

        <!-- Quick cash buttons -->
        <div class="cash-quick">
          <button type="button" class="cash-btn" onclick="setExact()">{% trans "Točno" %}</button>
          <button type="button" class="cash-btn" onclick="addCash(5)">+5 €</button>
          <button type="button" class="cash-btn" onclick="addCash(10)">+10 €</button>
          <button type="button" class="cash-btn" onclick="addCash(20)">+20 €</button>
          <button type="button" class="cash-btn" onclick="addCash(50)">+50 €</button>
        </div>

        <!-- Change display -->
        <div class="change-box" id="chgBox">
          <div class="change-lbl">{% trans "Kusur" %}</div>
          <div class="change-val" id="chgVal">{% trans "&euro;0.00" %}</div>
        </div>

        <!-- PAY button -->
        <button type="submit" id="payBtn" class="btn btn-green btn-pay"
                {% if not items and receipt.status != "ISSUED" %}disabled title="Dodajte stavke"{% endif %}>
          &#10003; Potvrdi naplatu &nbsp;&euro;{{ receipt.total|floatformat:2 }}
        </button>
      </form>
    </div>

    <div class="ab">
      <button type="button" class="btn btn-red btn-cancel"
              onclick="openStornoModal()">{% trans "Otkaži bon" %}</button>
    </div>

<!-- Storno modal -->
<div id="stornoModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:500;align-items:center;justify-content:center">
  <div style="background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.5rem;width:360px;max-width:95vw">
    <div style="font-size:1rem;font-weight:700;color:var(--red);margin-bottom:1rem">Storniraj bon #{{ receipt.receipt_number }}</div>
    <label style="font-size:.78rem;color:var(--muted);display:block;margin-bottom:.3rem">Razlog storniranja</label>
    <select id="stornoReasonSelect" onchange="onReasonChange(this.value)"
            style="width:100%;background:var(--dark);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:.5rem;font-size:.875rem;margin-bottom:.5rem;outline:none">
      <option value="">— Odaberite razlog —</option>
      <option value="Kupac odustao">Kupac odustao</option>
      <option value="Pogrešan unos">Pogrešan unos</option>
      <option value="Zamjena načina plaćanja">Zamjena načina plaćanja</option>
      <option value="Tehnička greška">Tehnička greška</option>
      <option value="Ostalo">Ostalo</option>
    </select>
    <input type="text" id="stornoReasonOther" placeholder="Unesite razlog..."
           style="display:none;width:100%;background:var(--dark);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:.5rem;font-size:.875rem;outline:none;margin-bottom:.5rem">
    <form method="post" action="{% url 'pos:cancel_receipt' receipt.id %}" id="cancelForm">
      {% csrf_token %}
      <input type="hidden" name="cancel_reason" id="cancelReasonHidden">
    </form>
    <div style="display:flex;gap:.5rem;margin-top:.75rem">
      <button onclick="closeStornoModal()" style="flex:1;background:rgba(255,255,255,.08);border:none;color:var(--text);border-radius:6px;padding:.6rem;font-size:.875rem;font-weight:600;cursor:pointer">Odustani</button>
      <button onclick="submitStorno()" style="flex:1;background:var(--red);border:none;color:#fff;border-radius:6px;padding:.6rem;font-size:.875rem;font-weight:700;cursor:pointer">Storniraj</button>
    </div>
  </div>
</div>

    {% elif receipt.status == "paid" %}
    <div class="pay" style="text-align:center;padding:2rem">
      <div style="font-size:3rem;margin-bottom:.75rem">&#10003;</div>
      <div style="font-weight:800;color:var(--green);margin-bottom:.5rem;font-size:1.1rem">{% trans "PLAĆENO" %}</div>
      <div style="font-size:.85rem;color:var(--muted);margin-bottom:.25rem">{{ receipt.paid_at|date:"d.m.Y H:i" }}</div>
      {% if receipt.jir %}<div style="font-size:.7rem;color:var(--muted);margin-bottom:1.25rem">JIR: {{ receipt.jir }}</div>{% endif %}
      <a href="{% url 'pos:receipt_pdf' receipt.id %}?format=thermal" class="btn btn-gold"
         style="width:100%;justify-content:center;margin-bottom:.5rem;min-height:52px;font-size:.9rem"
         target="_blank">{% trans "&#128424; Ispisi (Thermal 80mm)" %}</a>
      <a href="{% url 'pos:receipt_pdf' receipt.id %}?format=a4" class="btn btn-ghost"
         style="width:100%;justify-content:center;min-height:48px;font-size:.85rem"
         target="_blank">{% trans "&#128196; Preuzmi (A4 PDF)" %}</a>
    </div>
    {% else %}
    <div class="pay" style="text-align:center;padding:2rem;color:var(--red)">
      <div style="font-size:2rem;margin-bottom:.5rem">{% trans "&times;" %}</div>
      <div>{{ receipt.get_status_display }}</div>
    </div>
    {% endif %}
  </div>
</div>

<script>
// ── Inventory data for autocomplete ──────────────────────────────────────────
const INV = [
  {% for inv in inventory_items %}{
    id:"{{ inv.id }}",
    name:"{{ inv.name|escapejs }}",
    sku:"{{ inv.sku|escapejs }}",
    price:"{{ inv.unit_price|stringformat:".2f" }}",
    tax:"{% if inv.tax_rate %}{{ inv.tax_rate.rate|stringformat:"g" }}{% else %}25{% endif %}",
    bc:"{{ inv.barcode|default:''|escapejs }}",
    unit:"{{ inv.unit }}"
  },{% endfor %}
];

// ── Quick Add from buttons — klik dodaje artikl, brzo bez reload ─────────────
function quickAdd(itemId) {
  var item = INV.find(function(i){ return String(i.id) === String(itemId); });
  if (!item) {
    fetch('/hr/pos/api/item/' + itemId + '/')
      .then(function(r){ return r.json(); })
      .then(function(d){
        if(d.id) {
          var synthItem = {id:d.id, name:d.name, price:d.price, tax:d.tax, bc:d.bc||'', sku:d.sku||'', unit:''};
          INV.push(synthItem);
          quickAdd(itemId);
        } else { showToast('Artikl nije pronađen', 'error'); }
      })
      .catch(function(){ showToast('Greška pri dohvatu artikla', 'error'); });
    return;
  }
  var btn = event && event.target ? event.target.closest('.qk-btn') : null;
  if (btn) { btn.style.opacity='0.5'; btn.style.pointerEvents='none'; }
  var form = new FormData();
  form.append('inventory_item_id', item.id);
  form.append('description', item.name);
  form.append('quantity', '1');
  form.append('unit_price', item.price);
  form.append('tax_rate', item.tax);
  form.append('barcode', item.bc || '');
  form.append('csrfmiddlewaretoken', getCsrf());
  var formEl = document.getElementById('aiForm');
  if (!formEl) { showToast('Bon je zatvoren — otvorite novi bon', 'warn'); return; }
  fetch(formEl.action, {method:'POST', body:form, credentials:'same-origin', redirect:'follow'})
    .then(function(r){ if(r.ok||r.redirected) location.reload(); else { showToast('Greška: '+r.status, 'error'); if(btn){btn.style.opacity='1';btn.style.pointerEvents='auto';} } })
    .catch(function(e){ showToast('Greška: '+e.message, 'error'); if(btn){btn.style.opacity='1';btn.style.pointerEvents='auto';} });
}

// ── Camera Barcode Scanner ────────────────────────────────────────────────────────────────────────
var camStream = null;
function openCamScanner() {
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    showToast('Kamera nije dostupna — koristite Chrome/Edge ili ručno unesite barkod', 'warn');
    return;
  }
  var ov = document.getElementById('camOverlay');
  if (ov) { ov.style.display='flex'; startCam(); return; }
  ov = document.createElement('div'); ov.id='camOverlay';
  ov.style.cssText='position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.95);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px';
  var inner = '<div style="color:#fff;font-size:1rem;margin-bottom:12px;font-weight:600">Skeniraj barkod kamerom</div>';
  inner += '<video id="camVideo" autoplay playsinline style="width:90%;max-width:400px;border-radius:10px;border:2px solid #c9a84c"></video>';
  inner += '<canvas id="camCanvas" style="display:none"></canvas>';
  inner += '<div id="camStatus" style="color:#c9a84c;margin-top:10px;font-size:.85rem">Cekam dozvolu kamere...</div>';
  inner += '<div style="margin-top:12px;display:flex;gap:10px">';
  inner += '<button onclick="closeCamScanner()" style="padding:10px 28px;border-radius:8px;border:1px solid #555;background:#222;color:#fff;cursor:pointer">Zatvori</button>';
  inner += '<button onclick="manualBarcodeInput()" style="padding:10px 28px;border-radius:8px;border:1px solid #c9a84c;background:#1a1a0a;color:#c9a84c;cursor:pointer">Rucni unos</button></div>';
  ov.innerHTML = inner;
  document.body.appendChild(ov);
  startCam();
}
function closeCamScanner() {
  var ov=document.getElementById('camOverlay'); if(ov) ov.style.display='none';
  if(camStream){camStream.getTracks().forEach(function(t){t.stop();});camStream=null;}
}
function manualBarcodeInput() { closeCamScanner(); var el=document.getElementById('bcIn'); if(el){el.focus();el.select();} }
function startCam() {
  var video=document.getElementById('camVideo'), status=document.getElementById('camStatus');
  navigator.mediaDevices.getUserMedia({video:{facingMode:'environment',width:{ideal:1280},height:{ideal:720}}})
    .then(function(stream){camStream=stream;video.srcObject=stream;status.textContent='Kamera aktivna — usmjerite na barkod';scanFrame();})
    .catch(function(e){
      var m='Kamera nedostupna.';
      if(e.name==='NotAllowedError') m='Dozvola za kameru je odbijena.
Idi u postavke preglednika i dozvoli pristup kameri.';
      else if(e.name==='NotFoundError') m='Kamera nije pronadjena na ovom uredaju.';
      else if(e.name==='NotReadableError') m='Kamera je zauzeta drugom aplikacijom.';
      else m+=' '+e.message;
      status.textContent=m; status.style.color='#ef4444';
    });
}
function scanFrame() {
  if(!camStream)return;
  var v=document.getElementById('camVideo'),c=document.getElementById('camCanvas');
  if(!v||v.readyState<2){setTimeout(scanFrame,200);return;}
  c.width=v.videoWidth;c.height=v.videoHeight;c.getContext('2d').drawImage(v,0,0);
  if('BarcodeDetector' in window){
    new BarcodeDetector({formats:['ean_13','ean_8','code_128','qr_code','code_39']}).detect(c)
      .then(function(bc){if(bc.length>0){closeCamScanner();document.getElementById('bcIn').value=bc[0].rawValue;lookupBC();return;}setTimeout(scanFrame,150);})
      .catch(function(){setTimeout(scanFrame,300);});
  } else {
    var st=document.getElementById('camStatus');
    st.innerHTML='Ovaj preglednik ne podrzava automatsko skeniranje.<br>Koristite <b>Chrome na mobitelu</b> ili unesite barkod rucno.';
    st.style.color='#f59e0b';
  }
}

// ── Searchable Autocomplete ───────────────────────────────────────────────────
const acInput   = document.getElementById('acInput');
const acDropdown= document.getElementById('acDropdown');
const acClear   = document.getElementById('acClear');
let acIdx = -1;

function renderAC(q) {
  const ql = q.toLowerCase();
  const matches = ql.length < 1 ? [] :
    INV.filter(i => i.name.toLowerCase().includes(ql) || i.sku.toLowerCase().includes(ql)).slice(0, 30);
  if (!matches.length) { acDropdown.style.display = 'none'; return; }
  acDropdown.innerHTML = matches.map((m, i) =>
    `<div class="ac-item" data-idx="${i}" onclick="selectAC(${INV.indexOf(m)})">
       <span class="ac-item-name">${m.name} <span class="ac-item-meta">${m.sku}</span></span>
       <span class="ac-item-price">&euro;${parseFloat(m.price).toFixed(2)}</span>
     </div>`
  ).join('');
  acDropdown.style.display = 'block';
  acIdx = -1;
}

acInput.addEventListener('input', function() {
  acClear.style.display = this.value ? 'block' : 'none';
  renderAC(this.value);
});

acInput.addEventListener('keydown', function(e) {
  const items = acDropdown.querySelectorAll('.ac-item');
  if (e.key === 'ArrowDown') { e.preventDefault(); acIdx = Math.min(acIdx+1, items.length-1); items.forEach((el,i)=>el.classList.toggle('highlighted',i===acIdx)); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); acIdx = Math.max(acIdx-1, 0); items.forEach((el,i)=>el.classList.toggle('highlighted',i===acIdx)); }
  else if (e.key === 'Enter' && acIdx >= 0) { e.preventDefault(); items[acIdx]?.click(); }
  else if (e.key === 'Escape') { acDropdown.style.display='none'; }
});

document.addEventListener('click', function(e) {
  if (!e.target.closest('#acInput') && !e.target.closest('#acDropdown')) acDropdown.style.display='none';
});

function selectAC(i) {
  const m = INV[i];
  if (!m) return;
  document.getElementById('inv_id').value   = m.id;
  document.getElementById('desc_f').value   = m.name;
  document.getElementById('price_f').value  = m.price;
  document.getElementById('tax_f').value    = m.tax;
  document.getElementById('bc_field').value = m.bc;
  acInput.value = m.name;
  acClear.style.display = 'block';
  acDropdown.style.display = 'none';
  document.getElementById('qty_f').focus();
  document.getElementById('qty_f').select();
}

function clearAC() {
  acInput.value = '';
  acClear.style.display = 'none';
  acDropdown.style.display = 'none';
  document.getElementById('inv_id').value   = '';
  document.getElementById('bc_field').value = '';
}

// ── Barcode lookup ────────────────────────────────────────────────────────────
function lookupBC() {
  const bc = document.getElementById('bcIn').value.trim();
  if (!bc) return;
  fetch('/pos/api/barcode/?barcode=' + encodeURIComponent(bc))
    .then(r => r.json())
    .then(d => {
      if (d.found) {
        document.getElementById('inv_id').value   = d.id;
        document.getElementById('desc_f').value   = d.name;
        document.getElementById('price_f').value  = d.price;
        document.getElementById('tax_f').value    = d.tax_rate;
        document.getElementById('bc_field').value = bc;
        document.getElementById('bcIn').value     = '';
        document.getElementById('qty_f').focus();
      } else {
        showToast('Artikl nije pronađen: ' + bc, 'error');
      }
    });
}
document.getElementById('bcIn')?.addEventListener('keydown', e => {
  if (e.key === 'Enter') { e.preventDefault(); lookupBC(); }
});

// ── Payment ───────────────────────────────────────────────────────────────────
const recTotal = parseFloat('{{ receipt.total|floatformat:2 }}');

function setM(v, el) {
  document.getElementById('payMethod').value = v;
  document.querySelectorAll('.mtab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}

function calcChg() {
  const p = parseFloat(document.getElementById('amtPaid').value) || 0;
  const c = Math.max(0, p - recTotal);
  const b = document.getElementById('chgBox');
  document.getElementById('chgVal').textContent = '€' + c.toFixed(2);
  b.classList.toggle('show', p > recTotal + 0.001);
}

function setExact() {
  document.getElementById('amtPaid').value = recTotal.toFixed(2);
  calcChg();
}

function addCash(n) {
  const cur = parseFloat(document.getElementById('amtPaid').value) || 0;
  document.getElementById('amtPaid').value = (cur + n).toFixed(2);
  calcChg();
}

function openStornoModal() {
  const m = document.getElementById('stornoModal');
  m.style.display = 'flex';
}

function closeStornoModal() {
  document.getElementById('stornoModal').style.display = 'none';
}

function onReasonChange(val) {
  const other = document.getElementById('stornoReasonOther');
  other.style.display = val === 'Ostalo' ? 'block' : 'none';
}

function submitStorno() {
  const sel = document.getElementById('stornoReasonSelect').value;
  const other = document.getElementById('stornoReasonOther').value.trim();
  const reason = sel === 'Ostalo' ? (other || 'Ostalo') : sel;
  document.getElementById('cancelReasonHidden').value = reason;
  document.getElementById('cancelForm').submit();
}

// ── Anti-double-click guard ───────────────────────────────────────────────────
function guardSubmit(form, loadingText, isPayment) {
  const btn = isPayment
    ? document.getElementById('payBtn')
    : document.getElementById('addBtn');
  if (!btn || btn.dataset.submitting === '1') return false;
  btn.dataset.submitting = '1';
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span>&nbsp;' + loadingText;
  return true;
}

// Reset guard if user navigates back
window.addEventListener('pageshow', function() {
  ['payBtn','addBtn'].forEach(id => {
    const b = document.getElementById(id);
    if (b) { b.disabled = false; delete b.dataset.submitting; }
  });
});
</script>

<!-- Pfand return modal -->
<div id="pfandModal" style="display:none;position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.85);align-items:center;justify-content:center;padding:1rem">
  <div style="background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.2rem;max-width:400px;width:100%">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
      <strong>&#8617; Povratna ambalaza</strong>
      <button onclick="closePfandModal()" style="background:none;border:none;color:var(--muted);font-size:1.2rem;cursor:pointer">&times;</button>
    </div>
    <div id="pfandList" style="max-height:280px;overflow-y:auto">Ucitavanje...</div>
  </div>
</div>
<script>
var _pfandItems=null;
function openPfandReturn(){
  document.getElementById('pfandModal').style.display='flex';
  if(!_pfandItems){
    fetch('/pos/api/pfand-items/').then(r=>r.json()).then(d=>{
      _pfandItems=d.items||[];
      renderPfandList();
    });
  } else renderPfandList();
}
function closePfandModal(){document.getElementById('pfandModal').style.display='none'}
function renderPfandList(){
  var el=document.getElementById('pfandList');
  if(!_pfandItems.length){el.innerHTML='<div style="color:var(--muted);text-align:center;padding:1rem">Nema pfand artikala.</div>';return}
  el.innerHTML=_pfandItems.map(function(it){
    return '<div style="display:flex;align-items:center;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--border)">'
      +'<div><div style="font-size:.85rem;font-weight:600">'+it.name+'</div><div style="font-size:.7rem;color:var(--muted)">-'+it.unit_price+' \u20ac</div></div>'
      +'<button onclick="addPfandReturn('+it.id+',\''+it.name.replace(/'/g,"\\'")+'\',-'+it.unit_price+')" style="background:var(--green);color:#000;border:none;padding:.4rem .8rem;border-radius:6px;font-weight:700;font-size:.8rem;cursor:pointer">+ Dodaj</button>'
      +'</div>';
  }).join('');
}
function addPfandReturn(id,name,price){
  var form=document.getElementById('aiForm');
  if(!form) return;
  // Create hidden inputs and submit
  var fd=new FormData(form);
  var csrf=document.querySelector('[name=csrfmiddlewaretoken]').value;
  fetch(form.action,{
    method:'POST',
    headers:{'X-CSRFToken':csrf},
    body:new URLSearchParams({
      csrfmiddlewaretoken:csrf,
      inventory_item:id,
      quantity:1,
      is_pfand_return:'true'
    })
  }).then(function(r){if(r.ok)location.reload()});
  closePfandModal();
}
</script>


<div id="posToast" style="position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:9999;display:none;background:#1e293b;color:#fff;padding:12px 24px;border-radius:10px;font-size:.9rem;font-weight:600;box-shadow:0 4px 20px rgba(0,0,0,.4);border-left:4px solid var(--gold,#c9a84c);min-width:220px;text-align:center"></div>

<script>
function showToast(msg, type) {
  var t = document.getElementById("posToast");
  t.textContent = msg;
  t.style.borderLeftColor = type==="error" ? "#ef4444" : type==="warn" ? "#f59e0b" : "#c9a84c";
  t.style.display = "block";
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(function(){ t.style.display="none"; }, 3000);
}
</script>

{% endblock %}
