</div>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"><\/script>
<script>
var html5Scanner = null;
function openScanner() {
  document.getElementById("scannerOverlay").style.display = "block";
  document.getElementById("scannerResult").textContent = "";
  document.getElementById("manualBarcode").value = "";
  html5Scanner = new Html5Qrcode("scannerVideo");
  html5Scanner.start(
    { facingMode: "environment" },
    { fps: 15, qrbox: { width: 280, height: 150 }, aspectRatio: 1.5,
      formatsToSupport: [0,1,2,3,6,7] },
    function(code) { onBarcodeScanned(code); },
    function() {}
  ).catch(function(e) {
    document.getElementById("scannerResult").textContent = "Kamera: " + e;
    document.getElementById("scannerResult").style.color = "#ef4444";
  });
}
function closeScanner() {
  document.getElementById("scannerOverlay").style.display = "none";
  if (html5Scanner) { html5Scanner.stop().catch(function(){}); html5Scanner = null; }
}
function onBarcodeScanned(code) {
  document.getElementById("scannerResult").textContent = "Skenirano: " + code;
  if (html5Scanner) html5Scanner.stop().catch(function(){});
  fetch("/pos/api/barcode/?barcode=" + encodeURIComponent(code))
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.id) {
        var btn = document.getElementById("pb-" + data.id);
        if (btn) { addProduct(btn); }
        document.getElementById("scannerResult").textContent = "Dodano: " + (data.name || code);
        document.getElementById("scannerResult").style.color = "#22c55e";
        setTimeout(function() { resumeScan(); }, 1200);
      } else {
        document.getElementById("scannerResult").textContent = "Nepoznat barkod: " + code;
        document.getElementById("scannerResult").style.color = "#ef4444";
        setTimeout(function() { resumeScan(); }, 2000);
      }
    }).catch(function() {
      document.getElementById("scannerResult").textContent = "Greska: " + code;
      document.getElementById("scannerResult").style.color = "#ef4444";
    });
}
function resumeScan() {
  if (!document.getElementById("scannerOverlay").style.display || document.getElementById("scannerOverlay").style.display === "none") return;
  document.getElementById("scannerResult").textContent = "";
  html5Scanner = new Html5Qrcode("scannerVideo");
  html5Scanner.start({ facingMode: "environment" },
    { fps: 15, qrbox: { width: 280, height: 150 }, aspectRatio: 1.5, formatsToSupport: [0,1,2,3,6,7] },
    function(c) { onBarcodeScanned(c); }, function() {}
  ).catch(function(){});
}
function manualLookup() {
  var code = document.getElementById("manualBarcode").value.trim();
  if (code) onBarcodeScanned(code);
}
document.addEventListener("keydown", function(e) { if (e.key === "F2") { e.preventDefault(); openScanner(); } });
<\/script>

{% endblock %}
