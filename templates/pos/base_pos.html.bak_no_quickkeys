{% load i18n %}
<!DOCTYPE html>
<html lang="hr">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>(function(){var t=localStorage.getItem('fina-theme');if(t==='light')document.documentElement.setAttribute('data-theme','light');})();</script>
<title>{% block title %}POS{% endblock %} -- LIMIT Connect</title>
<style>
/* ═══ DARK THEME (default for POS) ═══ */
:root{
  --black:#0a0a0a;--dark:#111;--card:#1a1a1a;--border:#2a2a2a;
  --gold:#c9a84c;--gold2:#e8c96a;--text:#e8e8e8;--muted:#888;
  --green:#4caf7d;--red:#e05c5c;
  --topbar-bg:#111;--topbar-border:#2a2a2a;--topbar-text:#e8e8e8;
  --body-bg:#0a0a0a;--input-bg:#0a0a0a;--input-border:#2a2a2a;
  --nav-hover:rgba(201,168,76,.12);--nav-active-text:var(--gold);
}
/* ═══ LIGHT THEME ═══ */
[data-theme="light"]{
  --black:#ffffff;--dark:#f8fafc;--card:#ffffff;--border:#e2e8f0;
  --text:#0f172a;--muted:#64748b;
  --topbar-bg:#ffffff;--topbar-border:#e2e8f0;--topbar-text:#0f172a;
  --body-bg:#f1f5f9;--input-bg:#ffffff;--input-border:#e2e8f0;
  --nav-hover:rgba(201,168,76,.08);--nav-active-text:#0f172a;
  --green:#16a34a;--red:#dc2626;
}
*{box-sizing:border-box;margin:0;padding:0}html,body{height:100%}
body{background:var(--body-bg);color:var(--text);font-family:system-ui,sans-serif;font-size:14px;display:flex;flex-direction:column;min-height:100vh;transition:background .3s,color .3s}
a{color:inherit;text-decoration:none}

/* ═══ TOPBAR ═══ */
.topbar{background:var(--topbar-bg);border-bottom:1px solid var(--topbar-border);padding:.5rem 1rem;display:flex;align-items:center;gap:.5rem;flex-shrink:0;flex-wrap:wrap;transition:background .3s}
.topbar-brand{font-weight:700;letter-spacing:.06em;color:var(--gold);font-size:1rem;white-space:nowrap}
.topbar-brand span{color:var(--text)}
.topbar-nav{display:flex;align-items:center;gap:.15rem;flex-wrap:wrap}
.topbar-nav a{padding:.3rem .6rem;border-radius:5px;font-size:.78rem;color:var(--muted);transition:all .2s;white-space:nowrap}
.topbar-nav a:hover,.topbar-nav a.active{background:var(--nav-hover);color:var(--gold)}
.topbar-nav .nav-sep{width:1px;height:16px;background:var(--border);margin:0 .25rem}
.topbar-right{margin-left:auto;display:flex;align-items:center;gap:.6rem;font-size:.8rem;color:var(--muted)}
.theme-btn{background:none;border:1px solid var(--border);border-radius:5px;padding:3px 7px;cursor:pointer;color:var(--gold);font-size:.8rem;transition:all .2s}
.theme-btn:hover{border-color:var(--gold);background:var(--nav-hover)}

/* ═══ MAIN ═══ */
.pos-main{flex:1;display:flex;flex-direction:column;overflow:hidden}
.messages{padding:.5rem 1.25rem}
.msg{padding:.6rem 1rem;border-radius:6px;margin-bottom:.35rem;font-size:.85rem}
.msg.success{background:rgba(76,175,125,.1);border:1px solid var(--green);color:var(--green)}
.msg.error{background:rgba(224,92,92,.1);border:1px solid var(--red);color:var(--red)}
.msg.warning{background:rgba(201,168,76,.1);border:1px solid var(--gold);color:var(--gold)}

/* ═══ COMPONENTS ═══ */
.card{background:var(--card);border:1px solid var(--border);border-radius:8px;transition:background .3s}
.btn{display:inline-flex;align-items:center;gap:.4rem;padding:.55rem 1.1rem;border-radius:6px;font-size:.825rem;font-weight:600;border:none;cursor:pointer;transition:all .15s;font-family:inherit;text-decoration:none}
.btn-gold{background:var(--gold);color:#000}.btn-gold:hover{background:var(--gold2)}
.btn-green{background:var(--green);color:#fff}.btn-green:hover{opacity:.85}
.btn-red{background:transparent;border:1px solid var(--red);color:var(--red)}.btn-red:hover{background:rgba(224,92,92,.1)}
.btn-ghost{background:transparent;border:1px solid var(--border);color:var(--muted)}.btn-ghost:hover{border-color:var(--gold);color:var(--gold)}
.btn-sm{padding:.35rem .7rem;font-size:.775rem}
.badge{display:inline-block;padding:.15rem .5rem;border-radius:20px;font-size:.7rem;font-weight:700}
.badge-open{background:rgba(76,175,125,.15);color:var(--green)}
.badge-closed{background:rgba(136,136,136,.15);color:var(--muted)}
.badge-paid{background:rgba(76,175,125,.15);color:var(--green)}
.badge-cancelled{background:rgba(224,92,92,.15);color:var(--red)}
.dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:.3rem}
.dot-green{background:var(--green)}.dot-grey{background:var(--muted)}

/* Light overrides for specific elements */
[data-theme="light"] .card{box-shadow:0 1px 3px rgba(0,0,0,.06)}
[data-theme="light"] .btn-gold{color:#000}
[data-theme="light"] .btn-green{color:#fff}
[data-theme="light"] input,[data-theme="light"] select,[data-theme="light"] textarea{
  background:var(--input-bg);border-color:var(--input-border);color:var(--text);
}
[data-theme="light"] table{color:var(--text)}
[data-theme="light"] th{background:#f8fafc;color:var(--muted)}
[data-theme="light"] td{border-color:var(--border)}

/* ═══ MOBILE ═══ */
@media(max-width:768px){
  .topbar{padding:.4rem .6rem;gap:.3rem}
  .topbar-nav{gap:.1rem}
  .topbar-nav a{padding:.25rem .4rem;font-size:.7rem}
  .topbar-nav .nav-sep{display:none}
  .topbar-right span.user-name{display:none}
}
</style>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
{% block extra_css %}{% endblock %}
</head>
<body>
<div class="topbar">
  <div class="topbar-brand">{% trans "FINA" %}<span>{% trans "-POS" %}</span></div>
  {% block topbar_nav %}<nav class="topbar-nav">
    <a href="{% url 'pos:dashboard' %}" {% if request.path == '/pos/' or '/terminal/' in request.path or '/session/' in request.path %}class="active"{% endif %}>
      <i class=""></i>{% trans "Terminali" %}</a>
    <a href="{% url 'pos:gastro_dashboard' %}" {% if '/gastro/' in request.path and '/kitchen/' not in request.path and '/kds/' not in request.path and '/qr/' not in request.path %}class="active"{% endif %}>
      {% trans "Gastro" %}</a>
    <a href="{% url 'pos:gastro_kitchen' %}" {% if '/kitchen/' in request.path or '/kds/' in request.path %}class="active"{% endif %}>
      {% trans "Kuhinja" %}</a>
    <a href="{% url 'pos:waiter_app' %}" {% if '/waiter/' in request.path %}class="active"{% endif %}>
      {% trans "Konobar" %}</a>
    <span class="nav-sep"></span>
    <a href="{% url 'pos:expiry_dashboard' %}" {% if '/expiry/' in request.path %}class="active"{% endif %}>
      {% trans "Rokovi" %}</a>
    <a href="{% url 'pos:voucher_list' %}" {% if '/vouchers/' in request.path %}class="active"{% endif %}>
      {% trans "Vaučeri" %}</a>
    <a href="{% url 'pos:fiscal_room' %}" {% if '/fiscal/' in request.path %}class="active"{% endif %}>
      {% trans "Fiskal" %}</a>
    <span class="nav-sep"></span>
    <a href="{% url 'pos:pos_settings' %}" {% if '/settings/' in request.path %}class="active"{% endif %}>
      {% trans "Postavke" %}</a>
  </nav>
{% endblock %}
  <div class="topbar-right">
    <button class="theme-btn" onclick="togglePosTheme()" title="Tamna/Svijetla tema" id="pos-theme-btn">&#9790;</button>
    <span class="user-name">{{ request.user.get_full_name|default:request.user.username }}</span>
    <a href="/" style="color:var(--muted)">&larr; ERP</a>
  </div>
</div>
{% if messages %}<div class="messages">{% for msg in messages %}<div class="msg {{ msg.tags }}">{{ msg }}</div>{% endfor %}</div>{% endif %}
<div class="pos-main">
{% block quick_nav %}{% include "pos/includes/quick_keys.html" %}{% endblock %}
{% block content %}{% endblock %}
</div>
{% include "pos/includes/sidebar.html" %}
<script>
function togglePosTheme(){
  var html=document.documentElement;
  var current=html.getAttribute('data-theme');
  var next=current==='light'?null:'light';
  if(next){html.setAttribute('data-theme','light');localStorage.setItem('fina-theme','light');}
  else{html.removeAttribute('data-theme');localStorage.setItem('fina-theme','dark');}
  updatePosThemeBtn();
}
function updatePosThemeBtn(){
  var btn=document.getElementById('pos-theme-btn');
  if(!btn)return;
  var isLight=document.documentElement.getAttribute('data-theme')==='light';
  btn.innerHTML=isLight?'&#9728;':'&#9790;';
}
updatePosThemeBtn();
</script>

<script>
// ═══ POS Offline Support ═══
(function(){
  var OFFLINE_KEY = 'pos_offline_sales';
  var ITEMS_KEY = 'pos_cached_items';

  // Detect online/offline
  window.posIsOnline = navigator.onLine;
  window.addEventListener('online', function(){
    window.posIsOnline = true;
    document.body.classList.remove('pos-offline');
    flushOfflineSales();
    showPosToast('Povezano! Sinkroniziram podatke...', 'success');
  });
  window.addEventListener('offline', function(){
    window.posIsOnline = false;
    document.body.classList.add('pos-offline');
    showPosToast('Offline mod — prodaja nastavlja lokalno', 'warning');
  });

  // Cache articles to localStorage when online
  window.cacheArticlesForOffline = function(items){
    try { localStorage.setItem(ITEMS_KEY, JSON.stringify(items)); }
    catch(e) { console.warn('Cache full:', e); }
  };

  // Get cached articles
  window.getOfflineArticles = function(){
    try { return JSON.parse(localStorage.getItem(ITEMS_KEY) || '[]'); }
    catch(e) { return []; }
  };

  // Queue offline sale
  window.queueOfflineSale = function(saleData){
    var q = JSON.parse(localStorage.getItem(OFFLINE_KEY) || '[]');
    saleData._offline_ts = Date.now();
    saleData._offline_id = 'OFF-' + Date.now() + '-' + Math.random().toString(36).substr(2,5);
    q.push(saleData);
    localStorage.setItem(OFFLINE_KEY, JSON.stringify(q));
    showPosToast('Prodaja spremljena offline (#' + q.length + ')', 'info');
    return saleData._offline_id;
  };

  // Flush offline sales when back online
  function flushOfflineSales(){
    var q = JSON.parse(localStorage.getItem(OFFLINE_KEY) || '[]');
    if(!q.length) return;
    var total = q.length;
    var sent = 0;
    q.forEach(function(sale, idx){
      fetch(sale._url, {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRFToken': getCookie('csrftoken')},
        body: JSON.stringify(sale)
      }).then(function(r){
        sent++;
        if(sent >= total){
          localStorage.setItem(OFFLINE_KEY, '[]');
          showPosToast('Sinkronizirano ' + total + ' offline prodaja!', 'success');
        }
      }).catch(function(e){
        console.error('Flush failed:', e);
      });
    });
  }

  // Toast notification
  window.showPosToast = function(msg, type){
    var el = document.createElement('div');
    el.className = 'pos-toast pos-toast-' + (type||'info');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function(){ el.classList.add('show'); }, 10);
    setTimeout(function(){ el.remove(); }, 4000);
  };

  // Offline indicator
  if(!navigator.onLine) document.body.classList.add('pos-offline');

  // Auto-flush on load if online
  if(navigator.onLine) setTimeout(flushOfflineSales, 2000);

  function getCookie(name){
    var v = document.cookie.match('(^|;)\s*' + name + '\s*=\s*([^;]+)');
    return v ? v.pop() : '';
  }
})();
</script>
<style>
.pos-offline::before {
  content: 'OFFLINE MOD';
  position: fixed; top: 0; left: 50%; transform: translateX(-50%);
  z-index: 9999; background: #f59e0b; color: #000;
  padding: 4px 20px; font-size: 11px; font-weight: 800;
  border-radius: 0 0 8px 8px; letter-spacing: 1px;
}
.pos-toast {
  position: fixed; bottom: 20px; right: 20px; z-index: 9999;
  padding: 12px 20px; border-radius: 8px; font-size: 13px; font-weight: 600;
  opacity: 0; transform: translateY(20px); transition: all 0.3s;
  max-width: 320px;
}
.pos-toast.show { opacity: 1; transform: translateY(0); }
.pos-toast-success { background: #059669; color: #fff; }
.pos-toast-warning { background: #d97706; color: #fff; }
.pos-toast-info { background: #2563eb; color: #fff; }
.pos-toast-error { background: #dc2626; color: #fff; }
</style>

{% block extra_js %}{% endblock %}
</body></html>