{% extends "pos/base_pos.html" %}
{% load i18n %}
{% block title %}Restoran – {{ terminal.name }}{% endblock %}
{% block extra_css %}
<style>
/* ── Layout ──────────────────────────────────────────────────────────────── */
.rpos-wrap{display:flex;height:calc(100vh - var(--topbar-h,56px));overflow:hidden}
.rpos-main{flex:1;display:flex;flex-direction:column;padding:1rem;overflow-y:auto;gap:1rem}
.rpos-side{width:360px;min-width:320px;background:var(--card);border-left:1px solid var(--border);display:flex;flex-direction:column}

/* ── Top bar ─────────────────────────────────────────────────────────────── */
.rbar{display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem;border-bottom:1px solid var(--border)}
.rbar-title{font-weight:700;font-size:1rem}
.rbar-sub{font-size:.72rem;color:var(--muted);margin-top:.1rem}

/* ── Table grid ───────────────────────────────────────────────────────────── */
.tables-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem}
.tables-hdr-title{font-size:.85rem;font-weight:700}
.tables-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(105px,1fr));gap:.65rem}
.tbl-card{border-radius:10px;border:2px solid var(--border);padding:.875rem .75rem;text-align:center;cursor:pointer;transition:all .18s;position:relative;user-select:none;min-height:88px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.2rem}
.tbl-card:hover{border-color:var(--gold);transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.3)}
.tbl-free{background:var(--card)}
.tbl-occupied{background:rgba(239,68,68,.08);border-color:#ef4444}
.tbl-paying{background:rgba(250,204,21,.08);border-color:#facc15}
.tbl-selected{border-color:var(--gold)!important;box-shadow:0 0 0 3px rgba(201,168,76,.3)!important}
.tbl-num{font-size:1.5rem;font-weight:800;line-height:1}
.tbl-lbl{font-size:.6rem;text-transform:uppercase;letter-spacing:.06em;opacity:.55}
.tbl-total{font-size:.72rem;font-weight:700;color:var(--gold)}
.tbl-items{font-size:.62rem;color:var(--muted)}
.dot-badge{position:absolute;top:7px;right:7px;width:9px;height:9px;border-radius:50%}
.dot-free{background:#22c55e}.dot-occ{background:#ef4444}.dot-pay{background:#facc15}

/* ── Add btn ─────────────────────────────────────────────────────────────── */
.tbl-add{border-style:dashed;opacity:.5;font-size:1.5rem}
.tbl-add:hover{opacity:1;border-color:var(--gold)}

/* ── Legend ──────────────────────────────────────────────────────────────── */
.legend{display:flex;gap:1rem;flex-wrap:wrap;margin-top:.5rem}
.leg-item{display:flex;align-items:center;gap:.35rem;font-size:.72rem;color:var(--muted)}
.leg-dot{width:9px;height:9px;border-radius:50%}

/* ── Right panel ─────────────────────────────────────────────────────────── */
.side-hdr{padding:.875rem 1rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.side-hdr-title{font-weight:700;font-size:.95rem}
.side-body{flex:1;overflow-y:auto;padding:.75rem}
.side-empty{text-align:center;padding:3rem 1rem;color:var(--muted);font-size:.85rem}
.side-footer{padding:.875rem;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:.5rem}

/* ── Items ───────────────────────────────────────────────────────────────── */
.r-items{display:flex;flex-direction:column;gap:.35rem}
.r-item{background:var(--dark);border-radius:6px;padding:.55rem .75rem;display:flex;align-items:center;gap:.5rem;font-size:.82rem}
.r-item-name{flex:1}
.r-item-qty{color:var(--muted);white-space:nowrap}
.r-item-price{font-weight:700;white-space:nowrap;min-width:55px;text-align:right}

/* ── Add item ────────────────────────────────────────────────────────────── */
.add-item-zone{margin-top:.75rem;border-top:1px solid var(--border);padding-top:.75rem}
.ac-wrap{position:relative}
.ac-input{width:100%;background:var(--dark);border:1px solid var(--border);border-radius:6px;color:var(--text);padding:.55rem .875rem;font-size:.82rem;font-family:inherit}
.ac-input:focus{outline:none;border-color:var(--gold)}
.ac-list{position:absolute;top:calc(100% + 4px);left:0;right:0;background:#1e1e1e;border:1px solid var(--gold);border-radius:6px;max-height:200px;overflow-y:auto;z-index:100;display:none}
.ac-list.open{display:block}
.ac-item{padding:.5rem .875rem;cursor:pointer;font-size:.82rem;display:flex;justify-content:space-between}
.ac-item:hover{background:rgba(201,168,76,.15)}
.ac-price{color:var(--gold);font-size:.78rem}
.qty-row{display:flex;align-items:center;gap:.5rem;margin-top:.5rem}
.qty-row label{font-size:.72rem;color:var(--muted);white-space:nowrap}
.qty-inp{width:70px;background:var(--dark);border:1px solid var(--border);border-radius:5px;color:var(--text);padding:.45rem .5rem;text-align:center;font-size:.875rem;font-family:inherit}
.qty-inp:focus{outline:none;border-color:var(--gold)}

/* ── Totals ──────────────────────────────────────────────────────────────── */
.totals-box{background:var(--dark);border-radius:7px;padding:.75rem;font-size:.82rem}
.tot-row{display:flex;justify-content:space-between;margin-bottom:.3rem;color:var(--muted)}
.tot-row.grand{font-size:1.1rem;font-weight:800;color:var(--text);margin-top:.4rem;padding-top:.4rem;border-top:1px solid var(--border)}

/* ── Payment overlay ─────────────────────────────────────────────────────── */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.78);display:flex;align-items:center;justify-content:center;z-index:500;opacity:0;pointer-events:none;transition:opacity .2s}
.overlay.open{opacity:1;pointer-events:all}
.modal{background:var(--card);border:1px solid var(--gold);border-radius:14px;padding:1.5rem;width:340px;max-width:95vw}
.modal h3{font-size:1rem;font-weight:700;margin-bottom:1rem}
.pay-ttl{font-size:1.75rem;font-weight:900;color:var(--gold);text-align:center;margin-bottom:1rem}
.cash-inp{width:100%;background:var(--dark);border:1px solid var(--border);border-radius:7px;color:var(--text);padding:.65rem 1rem;font-size:1.1rem;text-align:center;font-family:inherit;margin-bottom:.5rem}
.cash-inp:focus{outline:none;border-color:var(--gold)}
.quick-cash{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:.75rem}
.qc{flex:1;min-width:55px;background:var(--dark);border:1px solid var(--border);border-radius:6px;color:var(--text);padding:.4rem .25rem;font-size:.78rem;cursor:pointer;text-align:center;transition:background .15s}
.qc:hover{background:rgba(201,168,76,.15);border-color:var(--gold)}
.chg-lbl{text-align:center;font-size:.85rem;color:var(--muted);min-height:1.4em;margin-bottom:.75rem}
.modal-btns{display:flex;gap:.5rem}
.modal-btns .btn{flex:1;padding:.65rem}

/* ── Success overlay ─────────────────────────────────────────────────────── */
.ok-box{text-align:center;background:var(--card);border:1px solid #22c55e;border-radius:14px;padding:2rem 2.5rem;max-width:320px;width:95vw}
.ok-icon{font-size:2.8rem;color:#22c55e;margin-bottom:.75rem}
.ok-num{font-size:1.4rem;font-weight:900;color:var(--gold);margin-bottom:.25rem}
.ok-total{font-size:1.1rem;font-weight:700;margin-bottom:.25rem}
.ok-chg{font-size:.9rem;color:var(--muted);margin-bottom:1rem}

/* ── Responsive ──────────────────────────────────────────────────────────── */
@media(max-width:768px){
  .rpos-wrap{flex-direction:column}
  .rpos-side{width:100%;border-left:none;border-top:1px solid var(--border);max-height:60vh}
}
</style>
{% endblock %}

{% block content %}
<div class="rpos-wrap">

  <!-- ═══ LEFT: Floor plan ════════════════════════════════════════════════ -->
  <div class="rpos-main">
    <div class="rbar">
      <div>
        <div class="rbar-title">{{ terminal.name }}</div>
        <div class="rbar-sub">
          {% if session %}Smjena #{{ session.session_number }} &mdash; {{ open_receipts|length }} aktivni bon{{ open_receipts|length|pluralize:",ovi" }}
          {% else %}<span style="color:#ef4444">{% trans "Nema aktivne smjene" %}</span>{% endif %}
        </div>
      </div>
      <div style="display:flex;gap:.5rem;align-items:center">
        {% if session %}<a href="{% url 'pos:session_detail' session.id %}" class="btn btn-ghost btn-sm">{% trans "Smjena &rarr;" %}</a>{% endif %}
        <a href="{% url 'pos:dashboard' %}" class="btn btn-ghost btn-sm">{% trans "&#8592; POS" %}</a>
      </div>
    </div>

    {% if not session %}
    <div style="text-align:center;padding:3rem;color:var(--muted)">
      <div style="font-size:1.1rem;margin-bottom:1rem">{% trans "Terminal nema aktivnu smjenu" %}</div>
      <form method="post" action="{% url 'pos:open_session' terminal.id %}">{% csrf_token %}
        <button class="btn btn-gold">{% trans "Pokreni smjenu" %}</button>
      </form>
    </div>
    {% else %}

    <!-- Table grid -->
    <div>
      <div class="tables-hdr">
        <div class="tables-hdr-title">{% trans "Raspored stolova" %}</div>
        <button class="btn btn-ghost btn-sm" onclick="openNewBonModal(null)">{% trans "+ Novi bon" %}</button>
      </div>

      <div class="tables-grid">
        {% for t in tables %}
        {% if t.receipt %}
        <div class="tbl-card tbl-occupied" data-table="{{ t.num }}" data-rid="{{ t.receipt.id }}" onclick="selectTable(this)">
          <div class="dot-badge dot-occ"></div>
          <div class="tbl-num">{{ t.num }}</div>
          <div class="tbl-lbl">{% trans "stol" %}</div>
          <div class="tbl-total">&euro;{{ t.receipt.total|floatformat:2 }}</div>
          <div class="tbl-items">{{ t.receipt.items.count }} st.</div>
        </div>
        {% else %}
        <div class="tbl-card tbl-free" data-table="{{ t.num }}" data-rid="" onclick="selectTable(this)">
          <div class="dot-badge dot-free"></div>
          <div class="tbl-num">{{ t.num }}</div>
          <div class="tbl-lbl">{% trans "slobodan" %}</div>
        </div>
        {% endif %}
        {% endfor %}

        <!-- Receipts without a numeric table (bar, takeaway) -->
        {% for r in open_receipts %}{% if not r.table_number %}
        <div class="tbl-card tbl-occupied" data-table="" data-rid="{{ r.id }}" onclick="selectTable(this)">
          <div class="dot-badge dot-occ"></div>
          <div class="tbl-num" style="font-size:1rem">Bon #{{ r.receipt_number }}</div>
          <div class="tbl-total">&euro;{{ r.total|floatformat:2 }}</div>
        </div>
        {% endif %}{% endfor %}

        <!-- Add custom table -->
        <div class="tbl-card tbl-add" onclick="openNewBonModal(null)">
          <div>+</div>
          <div class="tbl-lbl">{% trans "stol" %}</div>
        </div>
      </div>

      <div class="legend">
        <div class="leg-item"><div class="leg-dot" style="background:#22c55e"></div>{% trans "Slobodan" %}</div>
        <div class="leg-item"><div class="leg-dot" style="background:#ef4444"></div>{% trans "Zauzet" %}</div>
        <div class="leg-item"><div class="leg-dot" style="background:#facc15"></div>{% trans "Plaća" %}</div>
      </div>
    </div>

    {% endif %}{# /if session #}
  </div>

  <!-- ═══ RIGHT: Receipt panel ════════════════════════════════════════════ -->
  <div class="rpos-side">
    <div class="side-hdr">
      <div class="side-hdr-title" id="panelTitle">{% trans "Odaberite stol" %}</div>
    </div>

    <div class="side-body">
      <div class="side-empty" id="emptyHint">
        <div style="font-size:2rem;margin-bottom:.5rem">{% trans "&#x1F374;" %}</div>
        {% trans "Kliknite na stol za prikaz narudžbe" %}
      </div>

      <div id="itemsZone" style="display:none">
        <div class="r-items" id="itemsList"></div>

        {% if session %}
        <div class="add-item-zone">
          <div style="font-size:.65rem;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:.4rem">{% trans "Dodaj stavku" %}</div>
          <div class="ac-wrap">
            <input class="ac-input" type="text" id="acInput" placeholder="{% trans "Pretraži artikal…" %}" autocomplete="off">
            <div class="ac-list" id="acList"></div>
          </div>
          <div class="qty-row">
            <label>{% trans "Kol:" %}</label>
            <input class="qty-inp" type="number" id="acQty" value="1" min="0.1" step="0.1">
            <button class="btn btn-gold btn-sm" onclick="addItemToReceipt()" style="flex:1">{% trans "Dodaj +" %}</button>
          </div>
        </div>
        {% endif %}
      </div>
    </div>

    <div class="side-footer" id="sideFooter" style="display:none">
      <div class="totals-box">
        <div class="tot-row"><span>{% trans "Neto:" %}</span><span id="fNeto">{% trans "&euro;0.00" %}</span></div>
        <div class="tot-row"><span>{% trans "PDV:" %}</span><span id="fPdv">{% trans "&euro;0.00" %}</span></div>
        <div class="tot-row grand"><span>{% trans "UKUPNO:" %}</span><span id="fTotal">{% trans "&euro;0.00" %}</span></div>
      </div>
      <div style="display:flex;gap:.5rem">
        <button class="btn btn-ghost" onclick="closePanel()">✕</button>
        <button class="btn btn-green" onclick="openPay('CASH')" style="flex:1">{% trans "Gotovina" %}</button>
        <button class="btn btn-gold" onclick="openPay('CARD')" style="flex:1">{% trans "Kartica" %}</button>
      </div>
    </div>
  </div>
</div>

<!-- ═══ Payment overlay ══════════════════════════════════════════════════ -->
<div class="overlay" id="payOverlay">
  <div class="modal">
    <h3 id="payTitle">{% trans "Naplata" %}</h3>
    <div class="pay-ttl" id="payTtl">{% trans "&euro;0.00" %}</div>
    <input class="cash-inp" type="number" id="cashInput" placeholder="{% trans "Primljeno…" %}" oninput="calcChg()" step="0.01">
    <div class="quick-cash">
      <button class="qc" onclick="setExact()">{% trans "Točno" %}</button>
      <button class="qc" onclick="addCash(5)">+5</button>
      <button class="qc" onclick="addCash(10)">+10</button>
      <button class="qc" onclick="addCash(20)">+20</button>
      <button class="qc" onclick="addCash(50)">+50</button>
    </div>
    <div class="chg-lbl" id="chgLbl"></div>

    <div style="margin-top:.5rem;margin-bottom:.5rem">
          <button class="btn btn-ghost btn-sm" onclick="openPfandReturn()" style="width:100%;font-size:.72rem">&#8617; Povratna ambalaza</button>
        </div>
    <!-- ── Napojnica (samo kartica) ── -->
    <div id="tipSection" style="display:none;margin-top:.75rem;border-top:1px solid rgba(255,255,255,.08);padding-top:.75rem">
      <div style="font-size:.72rem;color:var(--muted);margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.05em">
        Napojnica (Trinkgeld)
      </div>
      <div style="display:flex;gap:.5rem;margin-bottom:.5rem">
        <button class="qc" onclick="setTip(0)" id="tipBtn0" style="background:rgba(201,168,76,.2);border-color:var(--gold)">Bez</button>
        <button class="qc" onclick="setTip(1)">+€1</button>
        <button class="qc" onclick="setTip(2)">+€2</button>
        <button class="qc" onclick="setTip(5)">+€5</button>
        <button class="qc" onclick="setTip(10)">+€10</button>
      </div>
      <div style="display:flex;align-items:center;gap:.5rem">
        <span style="font-size:.72rem;color:var(--muted);white-space:nowrap">Vlastiti iznos €</span>
        <input class="cash-inp" type="number" id="tipCustom" placeholder="0.00" min="0" step="0.50"
               oninput="setCustomTip()" style="font-size:.9rem;padding:.4rem .6rem;">
      </div>
      <div id="tipDisplay" style="font-size:.8rem;color:var(--gold);margin-top:.4rem;min-height:1.2rem"></div>
    </div>

    <div class="modal-btns">
      <button class="btn btn-ghost" onclick="closePay()">{% trans "Odustani" %}</button>
      <button class="btn btn-gold" id="payConfirmBtn" onclick="confirmPay()">{% trans "Naplati" %}</button>
    </div>
  </div>
</div>

<!-- ═══ Success overlay ═══════════════════════════════════════════════════ -->
<div class="overlay" id="okOverlay">
  <div class="ok-box">
    <div class="ok-icon">&#10003;</div>
    <div class="ok-num" id="okNum">{% trans "Bon #–" %}</div>
    <div class="ok-total" id="okTotal">{% trans "&euro;0.00" %}</div>
    <div class="ok-chg" id="okChg"></div>
    <div style="display:flex;gap:.5rem;justify-content:center;margin-top:.75rem">
      <a id="okPrint" href="#" target="_blank" class="btn btn-ghost btn-sm">{% trans "Ispiši" %}</a>
      <button class="btn btn-gold btn-sm" onclick="closeOk()">{% trans "OK" %}</button>
    </div>
  </div>
</div>

<!-- ═══ New-bon modal ════════════════════════════════════════════════════ -->
<div class="overlay" id="newBonOverlay">
  <div class="modal">
    <h3>{% trans "Novi bon" %}</h3>
    <div style="margin-bottom:.75rem">
      <label style="font-size:.72rem;color:var(--muted);display:block;margin-bottom:.35rem">{% trans "Broj stola (ostavite prazno za šank / dostavu)" %}</label>
      <input class="cash-inp" type="number" id="newBonTable" placeholder="{% trans "npr. 7" %}" min="1" max="200" style="font-size:.95rem">
    </div>
    <div class="modal-btns">
      <button class="btn btn-ghost" onclick="closeNewBon()">{% trans "Odustani" %}</button>
      <button class="btn btn-gold" onclick="createBon()">{% trans "Otvori bon" %}</button>
    </div>
  </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
const SESSION_ID = {{ session.id|default:"null" }};
const CSRF       = '{{ csrf_token }}';

/* ─── Inventory ─────────────────────────────────────────────────────────── */
const INV = [
{% for item in inventory_items %}{id:{{ item.id }},name:"{{ item.name|escapejs }}",price:"{{ item.selling_price|default:'0' }}",tax:{{ item.tax_rate.rate|default:25 }}},
{% endfor %}];

/* ─── Panel state ────────────────────────────────────────────────────────── */
let activeRid   = null;
let activeTotal = 0;
let payMethod   = 'CASH';
let selItem     = null;

function selectTable(el) {
  document.querySelectorAll('.tbl-card').forEach(c=>c.classList.remove('tbl-selected'));
  el.classList.add('tbl-selected');
  const rid   = el.dataset.rid;
  const tNum  = el.dataset.table;
  const label = tNum ? `Stol ${tNum}` : el.querySelector('.tbl-num').textContent;
  document.getElementById('panelTitle').textContent = label;

  if (rid) {
    loadReceipt(parseInt(rid));
  } else {
    // Free table → open new bon
    openNewBonModal(tNum || null);
  }
}

async function loadReceipt(rid) {
  const resp = await fetch(`/pos/receipt/${rid}/json/`);
  const data = await resp.json();
  if (!data.ok) { alert(data.error||'Greška'); return; }
  activeRid   = rid;
  activeTotal = parseFloat(data.total||0);
  renderItems(data.items||[]);
  updateTotals(data.subtotal||data.total||0, data.tax_amount||0, data.total||0);
  document.getElementById('emptyHint').style.display  = 'none';
  document.getElementById('itemsZone').style.display  = '';
  document.getElementById('sideFooter').style.display = '';
}

function renderItems(items) {
  document.getElementById('itemsList').innerHTML = items.map(it=>`
    <div class="r-item">
      <div class="r-item-name">${it.description}</div>
      <div class="r-item-qty">&times;${parseFloat(it.quantity)}</div>
      <div class="r-item-price">&euro;${parseFloat(it.line_total||0).toFixed(2)}</div>
    </div>`).join('');
}

function updateTotals(net, tax, total) {
  document.getElementById('fNeto').textContent  = '€'+parseFloat(net).toFixed(2);
  document.getElementById('fPdv').textContent   = '€'+parseFloat(tax).toFixed(2);
  document.getElementById('fTotal').textContent = '€'+parseFloat(total).toFixed(2);
  activeTotal = parseFloat(total);
}

function closePanel() {
  activeRid = null;
  document.querySelectorAll('.tbl-card').forEach(c=>c.classList.remove('tbl-selected'));
  document.getElementById('panelTitle').textContent    = 'Odaberite stol';
  document.getElementById('emptyHint').style.display   = '';
  document.getElementById('itemsZone').style.display   = 'none';
  document.getElementById('sideFooter').style.display  = 'none';
}

/* ─── Autocomplete ────────────────────────────────────────────────────────── */
const acInput = document.getElementById('acInput');
const acList  = document.getElementById('acList');
if (acInput) {
  acInput.addEventListener('input',()=>{
    const q = acInput.value.toLowerCase();
    if (!q){ acList.classList.remove('open'); return; }
    const hits = INV.filter(i=>i.name.toLowerCase().includes(q)).slice(0,30);
    acList.innerHTML = hits.map(i=>`<div class="ac-item" onclick="pickItem(${i.id})">
      <span>${i.name}</span><span class="ac-price">&euro;${parseFloat(i.price).toFixed(2)}</span></div>`).join('')
      || '<div class="ac-item" style="color:var(--muted)">Nema rezultata</div>';
    acList.classList.add('open');
  });
  document.addEventListener('click',e=>{
    if (!acInput.contains(e.target)&&!acList.contains(e.target)) acList.classList.remove('open');
  });
}
function pickItem(id) {
  selItem = INV.find(i=>i.id===id);
  if (!selItem) return;
  acInput.value = selItem.name;
  acList.classList.remove('open');
  document.getElementById('acQty').focus();
}

async function addItemToReceipt() {
  if (!activeRid){ alert('Odaberite stol/bon'); return; }
  if (!selItem){ alert('Odaberite artikal'); return; }
  const qty = parseFloat(document.getElementById('acQty').value)||1;
  const resp = await fetch(`/pos/receipt/${activeRid}/add-item/`,{
    method:'POST',headers:{'X-CSRFToken':CSRF,'Content-Type':'application/json'},
    body:JSON.stringify({inventory_item_id:selItem.id,description:selItem.name,quantity:qty,unit_price:selItem.price,tax_rate:selItem.tax})
  });
  const data = await resp.json();
  if (data.ok){
    renderItems(data.items||[]);
    updateTotals(data.subtotal||data.total||0, data.tax_amount||0, data.total||0);
    acInput.value=''; acList.classList.remove('open'); document.getElementById('acQty').value='1'; selItem=null;
    // Update table card total
    const card = document.querySelector(`.tbl-card[data-rid="${activeRid}"]`);
    if (card){ const t=card.querySelector('.tbl-total'); if(t) t.textContent='€'+parseFloat(data.total).toFixed(2); }
  } else { alert(data.error||'Greška'); }
}

/* ─── Payment ─────────────────────────────────────────────────────────────── */
function openPay(method){
  if (!activeRid){ alert('Odaberite bon'); return; }
  payMethod = method;
  tipAmount = 0;
  document.getElementById('tipCustom').value = '';
  document.getElementById('tipDisplay').textContent = '';
  document.querySelectorAll('#tipSection .qc').forEach(b => b.style.background = '');
  document.getElementById('tipBtn0').style.background = 'rgba(201,168,76,.2)';
  document.getElementById('tipSection').style.display = 'block';
  document.getElementById('payTitle').textContent = method==='CASH'?'Naplata – gotovina':'Naplata – kartica';
  document.getElementById('payTtl').textContent   = '€'+activeTotal.toFixed(2);
  document.getElementById('cashInput').value      = '';
  document.getElementById('chgLbl').textContent   = '';
  if (method==='CARD'){
    document.getElementById('cashInput').value    = activeTotal.toFixed(2);
    document.getElementById('cashInput').disabled = true;
  } else {
    document.getElementById('cashInput').disabled = false;
    setTimeout(()=>document.getElementById('cashInput').focus(),80);
  }
  document.getElementById('payOverlay').classList.add('open');
}
function closePay(){ document.getElementById('payOverlay').classList.remove('open'); }
function setExact(){ document.getElementById('cashInput').value=activeTotal.toFixed(2); calcChg(); }
function addCash(n){ const c=parseFloat(document.getElementById('cashInput').value)||0; document.getElementById('cashInput').value=(c+n).toFixed(2); calcChg(); }
function calcChg(){
  if(payMethod==='CARD'){ document.getElementById('chgLbl').textContent=''; return; }
  const paid=parseFloat(document.getElementById('cashInput').value)||0;
  const chg=paid-activeTotal;
  document.getElementById('chgLbl').textContent = chg>=0?`Kusur: €${chg.toFixed(2)}`:`Nedostaje: €${Math.abs(chg).toFixed(2)}`;
}

let paying=false;
async function confirmPay(){
  if(paying) return;
  const paid=parseFloat(document.getElementById('cashInput').value)||0;
  if(payMethod==='CASH'&&paid<activeTotal){ alert('Primljeni iznos je manji od ukupnog!'); return; }
  paying=true;
  document.getElementById('payConfirmBtn').textContent='…';

  // Napojnica: dodaj stavku na bon prije naplate ako postoji
  if(tipAmount > 0) {
    try {
      await fetch(`/pos/receipt/${activeRid}/add-item/`, {
        method:'POST', headers:{'X-CSRFToken':CSRF,'Content-Type':'application/json'},
        body: JSON.stringify({
          description: 'Napojnica (Trinkgeld)',
          quantity: '1',
          unit_price: tipAmount.toFixed(2),
          tax_rate: '0',
          is_tip: true,
        })
      });
    } catch(e) { console.warn('Tip add failed:', e); }
  }

  const resp=await fetch(`/pos/receipt/${activeRid}/pay/`,{
    method:'POST',headers:{'X-CSRFToken':CSRF,'Content-Type':'application/json'},
    body:JSON.stringify({method:payMethod,amount_paid:(paid+tipAmount).toFixed(2)})
  });
  const data=await resp.json();
  paying=false;
  document.getElementById('payConfirmBtn').textContent='Naplati';
  if(data.ok){
    closePay();
    document.getElementById('okNum').textContent   = `Bon #${data.receipt_number}`;
    document.getElementById('okTotal').textContent = `€${parseFloat(data.total).toFixed(2)}`;
    document.getElementById('okChg').textContent   = parseFloat(data.change)>0?`Kusur: €${parseFloat(data.change).toFixed(2)}`:'';
    document.getElementById('okPrint').href        = data.print_url||'#';
    document.getElementById('okOverlay').classList.add('open');
    setTimeout(closeOk, 5000);
  } else { alert(data.error||'Greška pri naplati'); }
}
function closeOk(){
  document.getElementById('okOverlay').classList.remove('open');
  location.reload();
}

/* ─── New bon ─────────────────────────────────────────────────────────────── */
function openNewBonModal(tableNum){
  document.getElementById('newBonTable').value = tableNum||'';
  document.getElementById('newBonOverlay').classList.add('open');
}
function closeNewBon(){ document.getElementById('newBonOverlay').classList.remove('open'); }
let creating=false;
async function createBon(){
  if(creating||!SESSION_ID){ alert('Nema aktivne smjene'); return; }
  creating=true;
  const tableNum = document.getElementById('newBonTable').value.trim()||null;
  const resp=await fetch(`/pos/session/${SESSION_ID}/new-receipt/`,{
    method:'POST',headers:{'X-CSRFToken':CSRF,'Content-Type':'application/json'},
    body:JSON.stringify({table_number:tableNum?parseInt(tableNum):null})
  });
  const data=await resp.json();
  creating=false;
  if(data.ok){ closeNewBon(); location.reload(); }
  else { alert(data.error||'Greška'); }
}
</script>

<!-- ── Fiscal Shield Widget ────────────────────────────────────────────────── -->
<div id="fiscal-shield" style="position:fixed;bottom:20px;right:20px;z-index:9999;cursor:pointer"
     onclick="window.location.href='/pos/fiscal/room/'" title="Fiskalna soba">
  <div id="shield-ring" style="width:48px;height:48px;background:#1a1a1a;border:2px solid #c9a84c;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 0 14px rgba(201,168,76,.35);transition:all .3s">
    <span id="shield-dot" style="width:10px;height:10px;background:#c9a84c;border-radius:50%;display:block"></span>
  </div>
  <div id="shield-badge" style="position:absolute;right:54px;bottom:12px;background:#c9a84c;color:#000;padding:2px 8px;border-radius:4px;font-size:.7rem;font-weight:800;white-space:nowrap;display:none;box-shadow:0 2px 6px rgba(0,0,0,.4)">0 ČEKA</div>
</div>
<style>
@keyframes pulse-gold{0%,100%{opacity:.5}50%{opacity:1}}
@keyframes pulse-red{0%,100%{opacity:.6}50%{opacity:1}}
.shield-ok{animation:pulse-gold 3s infinite}
.shield-warn{animation:pulse-red .6s infinite;background:#ef4444 !important;box-shadow:0 0 16px rgba(239,68,68,.6) !important}
</style>
<script>
(function shieldInit(){
  function updateShield(){
    fetch('/pos/fiscal/status-api/')
      .then(r=>r.json())
      .then(d=>{
        const dot=document.getElementById('shield-dot');
        const ring=document.getElementById('shield-ring');
        const badge=document.getElementById('shield-badge');
        if(!dot) return;
        if(d.pending>0){
          dot.className='shield-warn';
          ring.style.borderColor='#ef4444';
          badge.textContent=d.pending+' ČEKA';
          badge.style.background='#ef4444';
          badge.style.display='block';
        } else {
          dot.className='shield-ok';
          ring.style.borderColor='#c9a84c';
          badge.style.display='none';
        }
      }).catch(()=>{});
  }
  updateShield();
  setInterval(updateShield, 15000);
})();
</script>


<!-- Pfand return modal -->
<div id="pfandModal" style="display:none;position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.85);align-items:center;justify-content:center;padding:1rem">
  <div style="background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.2rem;max-width:400px;width:100%">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
      <strong>&#8617; Povratna ambalaza</strong>
      <button onclick="closePfandModal()" style="background:none;border:none;color:var(--muted);font-size:1.2rem;cursor:pointer">&times;</button>
    </div>
    <div id="pfandList" style="max-height:280px;overflow-y:auto">Ucitavanje...</div>
  </div>
</div>
<script>
var _pfandItems=null;
function openPfandReturn(){
  if(!activeRid){alert('Nema otvorenog bona.');return}
  document.getElementById('pfandModal').style.display='flex';
  if(!_pfandItems){
    fetch('/pos/api/pfand-items/').then(r=>r.json()).then(d=>{
      _pfandItems=d.items||[];
      renderPfandList();
    });
  } else renderPfandList();
}
function closePfandModal(){document.getElementById('pfandModal').style.display='none'}
function renderPfandList(){
  var el=document.getElementById('pfandList');
  if(!_pfandItems.length){el.innerHTML='<div style="color:var(--muted);text-align:center;padding:1rem">Nema pfand artikala.</div>';return}
  el.innerHTML=_pfandItems.map(function(it){
    return '<div style="display:flex;align-items:center;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--border)">'
      +'<div><div style="font-size:.85rem;font-weight:600">'+it.name+'</div><div style="font-size:.7rem;color:var(--muted)">-'+it.unit_price+' \u20ac</div></div>'
      +'<button onclick="addPfandReturn('+it.id+',\''+it.name.replace(/'/g,"\\'")+'\',-'+it.unit_price+')" style="background:var(--green);color:#000;border:none;padding:.4rem .8rem;border-radius:6px;font-weight:700;font-size:.8rem;cursor:pointer">+ Dodaj</button>'
      +'</div>';
  }).join('');
}
async function addPfandReturn(id,name,price){
  if(!activeRid) return;
  var csrf=document.querySelector('[name=csrfmiddlewaretoken]').value;
  await fetch('/pos/receipt/'+activeRid+'/add-item/',{
    method:'POST',
    headers:{'Content-Type':'application/json','X-CSRFToken':csrf},
    body:JSON.stringify({inventory_item_id:id,quantity:1,unit_price:price,description:name,is_pfand_return:true})
  });
  closePfandModal();
  loadReceipt(activeRid);
}
</script>

{% endblock %}
