{% extends "worktime/base_worktime.html" %}
{% load i18n %}
{% block title %}Tjedni unos{% endblock %}
{% block page_title %}
<div class="flex items-center gap-3">
    <span class="text-2xl">📅</span>
    <div>
        <h1 class="text-xl font-bold">{% trans "Tjedni unos sati" %}</h1>
        <p class="text-sm text-slate-500">{{ week_start|date:"d.m.Y." }} – tjedan</p>
    </div>
</div>
{% endblock %}
{% block worktime_content %}
<div class="mb-4 flex items-center gap-3 flex-wrap">
    <a href="?week={{ week_offset|add:'-1' }}" class="px-4 py-2 bg-white rounded-lg border hover:bg-slate-50 text-sm">{% trans "← Prethodni" %}</a>
    <a href="?week=0" class="px-4 py-2 bg-blue-50 text-blue-600 rounded-lg border border-blue-200 text-sm font-medium">{% trans "Ovaj tjedan" %}</a>
    <a href="?week={{ week_offset|add:'1' }}" class="px-4 py-2 bg-white rounded-lg border hover:bg-slate-50 text-sm">{% trans "Sljedeći →" %}</a>
</div>
<form method="post">{% csrf_token %}
    <div class="bg-white rounded-xl shadow-sm border overflow-x-auto">
        <table class="w-full">
            <thead class="bg-slate-50">
                <tr>
                    <th class="px-4 py-3 text-left text-sm font-semibold text-slate-600 min-w-[200px]">{% trans "Projekt" %}</th>
                    {% for d in days %}
                    <th class="px-3 py-3 text-center text-sm font-semibold min-w-[90px] {% if d == today %}text-blue-600 bg-blue-50{% else %}text-slate-600{% endif %}">
                        <div>{{ d|date:"D" }}</div><div class="text-xs font-normal">{{ d|date:"d.m." }}</div>
                    </th>
                    {% endfor %}
                    <th class="px-3 py-3 text-center text-sm font-semibold text-slate-600">Σ</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                {% for p in projects %}
                <tr class="hover:bg-slate-50">
                    <td class="px-4 py-2">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 rounded-full" style="background:{{ p.color }}"></div>
                            <div><div class="text-sm font-medium">{{ p.code }}</div><div class="text-xs text-slate-400">{{ p.name }}</div></div>
                        </div>
                    </td>
                    {% for d in days %}
                    <td class="px-1 py-2 text-center">
                        <input type="number" name="hours_{{ p.id }}_{{ d|date:'Y-m-d' }}" step="0.25" min="0" max="24"
                               class="w-full px-2 py-1.5 text-center text-sm border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </td>
                    {% endfor %}
                    <td class="px-3 py-2 text-center text-sm font-bold text-slate-400">—</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot class="bg-slate-50 font-semibold">
                <tr>
                    <td class="px-4 py-3 text-sm">{% trans "UKUPNO" %}</td>
                    {% for dt in day_totals %}
                    <td class="px-3 py-3 text-center text-sm {% if dt > 8 %}text-red-600{% elif dt > 0 %}text-green-600{% else %}text-slate-400{% endif %}">{{ dt|floatformat:1 }}h</td>
                    {% endfor %}
                    <td class="px-3 py-3 text-center text-sm text-blue-600">{{ total_week|floatformat:1 }}h</td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="mt-4 flex items-center gap-3">
        <button type="submit" class="px-8 py-3 bg-blue-600 text-white rounded-xl font-semibold hover:bg-blue-700">{% trans "✓ Spremi tjedne sate" %}</button>
        <a href="{% url 'ts_worker' %}" class="px-6 py-3 bg-slate-100 text-slate-700 rounded-xl font-semibold hover:bg-slate-200">{% trans "← Natrag" %}</a>
    </div>
</form>
{% endblock %}
