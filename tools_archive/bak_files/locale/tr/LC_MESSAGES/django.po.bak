msgid "Previše neuspješnih pokušaja. Pričekajte 15 minuta."
msgstr "Çok fazla başarısız deneme yapıldı. 15 dakika bekleyin."

msgid "Dobrodošli, {user.first_name or user.username}!"
msgstr "Hoş geldiniz, {user.first_name veya user.username}!"

msgid "Pogrešni podaci za prijavu."
msgstr "Yanlış giriş bilgileri."

msgid "Ako email postoji, link je poslan."
msgstr "E-posta olarak, link gönderildi."

msgid "Previše zahtjeva. Pričekajte 10 minuta."
msgstr "Çok fazla istek var. Lütfen 10 dakika bekleyin."

msgid "Link za pristup poslan na {email}. Vrijedi 24 sata."
msgstr "Erişim bağlantısı {email} adresine gönderilmiştir. 24 saat boyunca geçerlidir."

msgid "Link nije valjan ili je istekao."
msgstr "Bağlantı geçersiz veya süresi dolmuş."

msgid "Link je istekao ili je već iskorišten. Zatražite novi."
msgstr "Bağlantı süresi dolmuş veya zaten kullanılmış. Lütfen yeni bir bağlantı isteyin."

msgid "Korisnički račun nije aktivan."
msgstr "Kullanıcı hesabı aktif değildir."

msgid "✓ 2FA aktiviran! Koristite Google Authenticator za prijavu."
msgstr "✓ 2FA etkinleştirildi! Giriş yapmak için Google Authenticator'ı kullanın."

