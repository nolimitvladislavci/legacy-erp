msgid "Investitor - projekti"
msgstr "Επενδυτής - Έργα"

msgid "Partner - fakture"
msgstr "Συνεργάτες - τιμολόγηση"

msgid "Radnik - upload slika"
msgstr "Radnik - upload image"

msgid "Reset lozinke"
msgstr "Επαναφορά lozinke"

msgid "Verifikacija emaila"
msgstr "Επαλήθευση email"

msgid "Magic token"
msgstr "Μαγικό σύμβολο"

msgid "Magic tokeni"
msgstr "Μαγικά tokeni"

msgid "Pokušaj prijave"
msgstr "Προσπάθεια σύνδεσης"

msgid "Pokušaji prijave"
msgstr "Προσπάθειες σύνδεσης"

msgid "Previše neuspješnih pokušaja. Pričekajte 15 minuta."
msgstr "Πάρα πολλές αποτυχημένες προσπάθειες. Περιμένετε 15 λεπτά."

msgid "Dobrodošli, {user.first_name or user.username}!"
msgstr "Καλώς ήρθες, {user.first_name ή user.username}!"

msgid "Pogrešni podaci za prijavu."
msgstr "Λανθασμένα στοιχεία σύνδεσης."

msgid "Ako email postoji, link je poslan."
msgstr "Όπως αναφέρεται στο email, ο σύνδεσμος έχει σταλεί."

msgid "Previše zahtjeva. Pričekajte 10 minuta."
msgstr "Πάρα πολλές αιτήσεις. Παρακαλώ περιμένετε 10 λεπτά."

msgid "Link za pristup poslan na {email}. Vrijedi 24 sata."
msgstr "Ο σύνδεσμος πρόσβασης έχει σταλεί στο {email}. Είναι έγκυρος για 24 ώρες."

msgid "Link nije valjan ili je istekao."
msgstr "Ο σύνδεσμος δεν είναι έγκυρος ή έχει λήξει."

msgid "Link je istekao ili je već iskorišten. Zatražite novi."
msgstr "Ο σύνδεσμος έχει λήξει ή έχει ήδη χρησιμοποιηθεί. Ζητήστε έναν νέο."

msgid "Korisnički račun nije aktivan."
msgstr "Ο λογαριασμός χρήστη δεν είναι ενεργός."

msgid "✓ 2FA aktiviran! Koristite Google Authenticator za prijavu."
msgstr "✓ 2FA ενεργοποιημένο! Χρησιμοποιήστε το Google Authenticator για να συνδεθείτε."

msgid "Pogrešan kod. Pokušajte ponovo."
msgstr "Λανθασμένος κωδικός. Δοκιμάστε ξανά."

msgid "✓ Uspješna 2FA provjera!"
msgstr "✓ Επιτυχής επαλήθευση 2FA!"

msgid "Greška provjere."
msgstr "Σφάλμα επαλήθευσης."

msgid "Ako email postoji, link za reset je poslan."
msgstr "Όπως αναφέρεται στο email, ο σύνδεσμος για την επαναφορά έχει σταλεί."

msgid "Lozinke se ne podudaraju."
msgstr "Οι κωδικοί πρόσβασης δεν ταιριάζουν."

msgid "Lozinka mora imati najmanje 8 znakova."
msgstr "Ο κωδικός πρόσβασης πρέπει να έχει μήκος τουλάχιστον 8 χαρακτήρες."

msgid "✓ Lozinka promijenjena! Prijavite se s novom lozinkom."
msgstr "✓ Το σύνθημα άλλαξε! Συνδεθείτε με το νέο σύνθημα."

msgid "Google login nije konfiguriran."
msgstr "Η σύνδεση στο Google δεν έχει ρυθμιστεί."

msgid "OAuth state mismatch."
msgstr "Αναντιστοιχία κατάστασης OAuth."

msgid "Prijavljeni ste putem Google: {email}"
msgstr "Έχετε εγγραφεί μέσω Google: {email}"

msgid "Greška Google prijave. Pokušajte ponovo."
msgstr "Σφάλμα στην εγγραφή Google. Δοκιμάστε ξανά."

msgid "Microsoft login nije konfiguriran."
msgstr "Η σύνδεση Microsoft δεν έχει ρυθμιστεί."

msgid "Prijavljeni ste putem Microsoft: {email}"
msgstr "Είστε συνδεδεμένοι μέσω Microsoft: {email}"

msgid "Greška Microsoft prijave."
msgstr "Σφάλμα στις συνδέσεις της Microsoft."

