msgstr "IPv4 ή IPv6"

msgid "Enter only digits separated by commas."
msgstr "Εισάγετε μόνο ψηφία διαχωρισμένα με κόμματα."

msgid "Ensure this value is %(limit_value)s (it is %(show_value)s)."
msgstr "Βεβαιωθείτε ότι αυτή η τιμή είναι %(limit_value)s (είναι %(show_value)s)."

msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "Βεβαιωθείτε ότι αυτή η τιμή είναι μικρότερη ή ίση με %(limit_value)s."

msgid "Ensure this value is greater than or equal to %(limit_value)s."
msgstr "Βεβαιωθείτε ότι αυτή η τιμή είναι μεγαλύτερη ή ίση με %(limit_value)s."

msgid "Ensure this value is a multiple of step size %(limit_value)s."
msgstr "Βεβαιωθείτε ότι αυτή η τιμή είναι πολλαπλάσιο του μεγέθους βήματος %(limit_value)s."

