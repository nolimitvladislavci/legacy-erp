{% extends "base.html" %}
{% block content %}
<div class="stat-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🌍 Upravljanje prijevodima: {{ lang_code|upper }}</h2>
        <div class="btn-group">
            <a href="?lang_code=de" class="btn btn-outline-primary {% if lang_code == 'de' %}active{% endif %}">Njemački</a>
            <a href="?lang_code=en" class="btn btn-outline-primary {% if lang_code == 'en' %}active{% endif %}">Engleski</a>
        </div>
    </div>

    
    <div class="card bg-white mb-4 border-0 shadow-sm" style="border-radius: 12px; border: 1px solid #e2e8f0 !important;">
        <div class="card-body d-flex flex-wrap gap-3 align-items-center">
            <form method="post" class="m-0">
                {% csrf_token %}
                <button type="submit" name="action" value="scan" class="btn btn-primary" style="font-weight: 600;">
                    <i class="fas fa-search me-1"></i> Skeniraj portal
                </button>
            </form>
            <form method="post" class="m-0">
                {% csrf_token %}
                <button type="submit" name="action" value="auto_translate" class="btn btn-warning" style="font-weight: 600;" onclick="this.innerHTML='<i class=\'fas fa-spinner fa-spin me-1\'></i> Prevodim...';">
                    <i class="fas fa-magic me-1"></i> Automatski prevedi sve
                </button>
            </form>
            <small class="text-muted ms-auto" style="font-size: 0.75rem;"><i class="fas fa-info-circle"></i> <b>Skeniraj</b> čupa nove riječi iz koda. <b>Prevedi</b> automatski ispunjava prazna polja.</small>
        </div>
    </div>
    <input type="text" id="translationSearch"
 class="form-control mb-3" placeholder="Pretraži pojmove...">

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th style="width: 45%;">Original (HR)</th>
                    <th style="width: 45%;">Prijevod ({{ lang_code|upper }})</th>
                    <th>Akcija</th>
                </tr>
            </thead>
            <tbody id="translationTable">
                {% for entry in entries %}
                <tr>
                    <form method="post">
                        {% csrf_token %}
                        <td>
                            <small class="text-muted d-block">{{ entry.occurrences.0.0 }}</small>
                            <strong>{{ entry.msgid }}</strong>
                            <input type="hidden" name="msgid" value="{{ entry.msgid }}">
                        </td>
                        <td>
                            <textarea name="msgstr" class="form-control form-control-sm" rows="1">{{ entry.msgstr }}</textarea>
                        </td>
                        <td>
                            <button type="submit" class="btn btn-success btn-sm">Spremi</button>
                        </td>
                    </form>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
document.getElementById('translationSearch').addEventListener('keyup', function() {
    let filter = this.value.toLowerCase();
    let rows = document.querySelectorAll('#translationTable tr');
    rows.forEach(row => {
        let text = row.innerText.toLowerCase();
        row.style.display = text.includes(filter) ? '' : 'none';
    });
});
</script>
{% endblock %}
