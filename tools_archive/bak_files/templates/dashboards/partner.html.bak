{% extends 'base.html' %}
{% load i18n %}
{% block title %}{% trans "Partner portal" %} – FINA-CONNECT{% endblock %}
{% block page_title %}{% trans "Vaši računi i termini" %}{% endblock %}
{% block content %}
<div style="display:flex;justify-content:flex-end;margin-bottom:10px;gap:3px;flex-wrap:wrap">
  {% load i18n %}{% get_current_language as CURRENT_LANG %}{% get_available_languages as LANGUAGES %}
  {% for lang_code, lang_name in LANGUAGES %}
  <form action="/i18n/setlang/" method="post" style="display:inline">
    {% csrf_token %}
    <input name="next" type="hidden" value="{{ request.get_full_path }}">
    <input name="language" type="hidden" value="{{ lang_code }}">
    {% if lang_code == CURRENT_LANG %}
    <button type="submit" style="padding:2px 9px;font-size:0.72rem;font-weight:700;border-radius:4px;cursor:pointer;border:1px solid #3b82f6;background:#3b82f6;color:#fff">{{ lang_code|upper }}</button>
    {% else %}
    <button type="submit" style="padding:2px 9px;font-size:0.72rem;font-weight:700;border-radius:4px;cursor:pointer;border:1px solid #cbd5e1;background:#f8fafc;color:#64748b">{{ lang_code|upper }}</button>
    {% endif %}
  </form>
  {% endfor %}
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6"><div class="stat-card d-flex justify-content-between align-items-start"><div><div class="label">{% trans "Neplaćeno" %}</div><div class="value text-danger">{{ unpaid_total|floatformat:2 }} €</div></div><div class="icon" style="background:#fee2e2;color:#ef4444"><i class="fas fa-exclamation-triangle"></i></div></div></div>
</div>
<div class="stat-card">
  <h6 class="fw-bold mb-3">{% trans "Vaši računi" %}</h6>
  <table class="table table-sm table-hover"><thead><tr><th>{% trans "Broj" %}</th><th>{% trans "Datum" %}</th><th>{% trans "Iznos" %}</th><th>{% trans "Status" %}</th></tr></thead>
  <tbody>{% for i in my_invoices %}<tr><td>{{ i.number }}</td><td>{{ i.date_issued|date:"d.m.Y" }}</td><td>{{ i.total }} €</td><td><span class="badge bg-{% if i.status == 'PAID' %}success{% elif i.status == 'UNPAID' %}danger{% else %}secondary{% endif %}">{{ i.status }}</span></td></tr>{% empty %}<tr><td colspan="4" class="text-muted text-center">{% trans "Nema računa" %}</td></tr>{% endfor %}</tbody>
  </table>
</div>
{% endblock %}
