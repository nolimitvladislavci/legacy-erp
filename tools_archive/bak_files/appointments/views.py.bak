from django.shortcuts import render
from django.contrib.auth.decorators import login_required
from rest_framework import viewsets, permissions
from .models import *
from .serializers import *

class AppointmentViewSet(viewsets.ModelViewSet):
    queryset = Appointment.objects.all()
    serializer_class = AppointmentSerializer
    permission_classes = [permissions.IsAuthenticated]

@login_required
def index(request):
    return render(request, 'appointments/index.html', {})
from django.shortcuts import render, get_object_or_404
from django.http import JsonResponse
from django.contrib.auth.decorators import login_required
from django.views.decorators.http import require_GET
from django.views.decorators.csrf import csrf_exempt
from .models import Appointment, BookingResource
from .forms import AppointmentForm
from partners.models import Partner

@login_required
def calendar_view(request):
    clients = Partner.objects.all()
    resources = BookingResource.objects.filter(is_active=True)
    return render(request, 'appointments/calendar.html', {'clients': clients, 'resources': resources})

@login_required
@require_GET
def api_events(request):
    appointments = Appointment.objects.all()
    events = []
    for app in appointments:
        client_name = app.client.name if app.client else 'Interno'
        events.append({
            'id': app.id,
            'title': f"{app.title} ({client_name})",
            'start': app.start_time.isoformat() if app.start_time else None,
            'end': app.end_time.isoformat() if app.end_time else None,
            'allDay': app.is_all_day,
            'backgroundColor': getattr(app, 'color', '#3b82f6'),
            'borderColor': getattr(app, 'color', '#3b82f6'),
            'extendedProps': {
                'type': app.get_appointment_type_display(),
                'status': app.get_status_display(),
                'resource_id': app.resource_id,
            }
        })
    return JsonResponse(events, safe=False)

@login_required
def api_appointments(request, pk=None):
    # API ENDPOINT ZA SPREMANJE I UREĐIVANJE (Ovo je nedostajalo)
    if request.method in ['POST', 'PUT']:
        if pk:
            appointment = get_object_or_404(Appointment, pk=pk)
            form = AppointmentForm(request.POST, instance=appointment)
        else:
            form = AppointmentForm(request.POST)

        if form.is_valid():
            appointment = form.save(commit=False)
            if not getattr(appointment, 'employee_id', None):
                appointment.employee = request.user
            appointment.save()
            return JsonResponse({'status': 'success', 'id': appointment.id})
        else:
            return JsonResponse({'status': 'error', 'errors': form.errors}, status=400)
            
    elif request.method == 'DELETE' and pk:
        appointment = get_object_or_404(Appointment, pk=pk)
        appointment.delete()
        return JsonResponse({'status': 'success'})
        
    return JsonResponse({'status': 'invalid method'}, status=405)


# === JAVNI BOOKING PORTAL VIEWS ===
import json
from datetime import datetime, timedelta
from django.utils.dateparse import parse_date
from django.views.decorators.csrf import csrf_exempt
from django.views.decorators.http import require_GET
from django.http import JsonResponse
from django.shortcuts import render, get_object_or_404
from .models import BookingService, WorkingHours, Appointment, BookingResource
from partners.models import Partner

def public_booking_index(request):
    services = BookingService.objects.filter(is_active=True)
    return render(request, 'appointments/public/index.html', {'services': services})

def public_booking_calendar(request, service_id):
    service = get_object_or_404(BookingService, id=service_id, is_active=True)
    return render(request, 'appointments/public/calendar.html', {'service': service})

@require_GET
def api_available_slots(request):
    date_str = request.GET.get('date')
    service_id = request.GET.get('service_id')
    
    if not date_str or not service_id:
        return JsonResponse({'error': 'Nedostaju parametri'}, status=400)
        
    target_date = parse_date(date_str)
    if not target_date or target_date < datetime.now().date():
        return JsonResponse({'slots': []})

    service = get_object_or_404(BookingService, id=service_id)
    weekday = target_date.weekday()
    
    resources = BookingResource.objects.filter(resource_type=service.resource_type, is_active=True)
    available_slots = set()
    service_duration = service.duration.total_seconds() / 60
    
    for resource in resources:
        wh = WorkingHours.objects.filter(resource=resource, day_of_week=weekday, is_day_off=False).first()
        if not wh:
            continue
            
        start_dt = datetime.combine(target_date, wh.start_time)
        end_dt = datetime.combine(target_date, wh.end_time)
        
        existing_apps = Appointment.objects.filter(
            resource=resource,
            start_time__date=target_date,
            status__in=['scheduled', 'confirmed']
        )
        
        current_slot = start_dt
        while current_slot + timedelta(minutes=service_duration) <= end_dt:
            slot_end = current_slot + timedelta(minutes=service_duration)
            overlap = False
            for app in existing_apps:
                if current_slot < app.end_time.replace(tzinfo=None) and slot_end > app.start_time.replace(tzinfo=None):
                    overlap = True
                    break
            
            if target_date == datetime.now().date() and current_slot.time() < datetime.now().time():
                overlap = True

            if not overlap:
                available_slots.add(current_slot.strftime('%H:%M'))
                
            current_slot += timedelta(minutes=30)
            
    return JsonResponse({'slots': sorted(list(available_slots))})

@csrf_exempt
def api_submit_public_booking(request):
    if request.method == 'POST':
        try:
            data = json.loads(request.body)
            service = get_object_or_404(BookingService, id=data['service_id'])
            target_date = parse_date(data['date'])
            time_str = data['time']
            
            name = data['name']
            email = data['email']
            phone = data.get('phone', '')
            whatsapp = data.get('whatsapp', '')
            payment_method = data.get('payment_method', 'invoice')
            
            client, created = Partner.objects.get_or_create(
                email=email,
                defaults={'name': name, 'phone': phone, 'partner_type': 'KUPAC'}
            )
            
            start_time = datetime.strptime(f"{data['date']} {time_str}", "%Y-%m-%d %H:%M")
            end_time = start_time + timedelta(minutes=service.duration.total_seconds() / 60)
            
            resources = BookingResource.objects.filter(resource_type=service.resource_type, is_active=True)
            assigned_resource = None
            for resource in resources:
                overlapping = Appointment.objects.filter(
                    resource=resource, start_time__lt=end_time, end_time__gt=start_time, status__in=['scheduled', 'confirmed']
                ).exists()
                if not overlapping:
                    assigned_resource = resource
                    break
                    
            if not assigned_resource:
                return JsonResponse({'error': 'Termin je upravo zauzet. Molimo odaberite drugi.'}, status=400)
            
            total_price = service.price if service.price else 0
            
            appointment = Appointment.objects.create(
                title=f"Online: {service.name}",
                client=client,
                service=service,
                resource=assigned_resource,
                start_time=start_time,
                end_time=end_time,
                appointment_type='service',
                status='scheduled',
                color='#10b981',
                total_price=total_price,
                payment_method=payment_method,
                whatsapp_number=whatsapp
            )
            
            invoice_created = False
            if payment_method == 'invoice' and total_price > 0:
                try:
                    from invoicing.models import Invoice
                    Invoice.objects.create(
                        partner=client,
                        date_issued=start_time.date(),
                        due_date=start_time.date(),
                        total_amount=total_price,
                        status='DRAFT',
                        notes=f"Automatska ponuda za rezervaciju: {service.name}"
                    )
                    invoice_created = True
                except Exception:
                    pass
            
            return JsonResponse({
                'status': 'success', 
                'booking_id': appointment.id,
                'total_price': float(total_price),
                'payment_method': payment_method,
                'invoice_created': invoice_created
            })
        except Exception as e:
            return JsonResponse({'error': str(e)}, status=500)
    return JsonResponse({'error': 'Invalid request'}, status=400)
