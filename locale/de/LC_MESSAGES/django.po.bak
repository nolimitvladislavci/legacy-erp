msgstr "Falsche Anmeldedaten."

msgid "Ako email postoji, link je poslan."
msgstr "Wie in der E-Mail angegeben, wurde der Link gesendet."

msgid "Previše zahtjeva. Pričekajte 10 minuta."
msgstr "Zu viele Anfragen. Bitte warten Sie 10 Minuten."

#, python-brace-format
msgid "Link za pristup poslan na {email}. Vrijedi 24 sata."
msgstr "Zugriffslink an {email} gesendet. Gültig für 24 Stunden."

msgid "Link nije valjan ili je istekao."
msgstr "Der Link ist ungültig oder abgelaufen."

msgid "Link je istekao ili je već iskorišten. Zatražite novi."
msgstr "Der Link ist abgelaufen oder wurde bereits verwendet. Bitte fordern Sie einen neuen an."
"Der Link ist abgelaufen oder wurde bereits verwendet. Fordern Sie ein neues "
"an.Der Link ist abgelaufen oder wurde bereits verwendet. Bitte fordern Sie "
"einen neuen an."

msgid "Korisnički račun nije aktivan."
msgstr "Das Benutzerkonto ist nicht aktiv."

