#: templates/memio_world/family_tree.html:124
msgid ""
"Djed je mamin tata ili tatin tata. Imaš DVA djeda! Djedovi znaju popraviti "
"sve i pričaju priče iz davnina. Njihov tata je tvoj pradjed."
msgstr ""

#: templates/memio_world/family_tree.html:125
msgid "Dječak iste mame i tate"
msgstr ""

#: templates/memio_world/family_tree.html:126
msgid ""
"Brat je dječak koji ima istu mamu i tatu kao ti. Stariji brat te štiti, "
"mlađi brat gleda u tebe. Brat je prijatelj kojeg nisi birao — ali je "
"zauvijek tvoj."
msgstr ""

