msgid "Djevojčica iste mame i tate"
msgstr ""

#: templates/memio_world/family_tree.html:128
msgid ""
"Sestra je djevojčica koja ima istu mamu i tatu kao ti. S njom se svađaš i "
"miriš, ali uvijek se volite. Sestra je kao zvijezda — uvijek svijetli za "
"tebe."
msgstr ""

