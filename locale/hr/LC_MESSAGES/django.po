#: templates/memio_world/family_tree.html:130
msgid ""
"Ujak je mamin brat. Ako mama ima brata — on je tvoj ujak! Ujakova djeca su "
"tvoji bratići i sestrične s mamine strane."
msgstr ""

#: templates/memio_world/family_tree.html:131
msgid "Mamina ili tatina sestra"
msgstr ""

#: templates/memio_world/family_tree.html:132
msgid ""
"Tetka je mamina sestra ili tatina sestra. Tetka je kao druga mama — voli te, "
"mazi te i ponekad ti kupi nešto što mama ne bi. Tetkina djeca su tvoji "
"bratići i sestrične."
msgstr ""

