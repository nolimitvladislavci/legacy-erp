diff --git a/otpad_katalog/ekran/static/prijava.js b/otpad_katalog/ekran/static/prijava.js
new file mode 100644
index 00000000..d484efe9
--- /dev/null
+++ b/otpad_katalog/ekran/static/prijava.js
@@ -0,0 +1,48 @@
+(function () {
+  'use strict';
+  // Prijava GenesisLoginom: SDK i popup su flotini (https://<auth>/static/genesis-auth.js); ovdje se samo pokreću.
+  // Token ostaje u localStorageu pod ključem koji postavlja SDK, a poslužitelj ga provjerava na svaki poziv.
+  var O = window.OTPAD, $ = O.$, poruka = O.poruka, zauzet = O.zauzet;
+  var konfig = null;
+
+  function prikazi(tekst) {
+    $('prijava').hidden = false;
+    if (tekst) poruka($('prijava-poruka'), 'info', tekst);
+    $('prijava-gumb').focus();
+  }
+  O.traziPrijavu = function (tekst) { if (konfig && konfig.prijava) prikazi(tekst); };
+
+  fetch('/api/konfig', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (k) {
+    konfig = k;
+    if (!k.prijava) return;
+    $('odjava').hidden = false;
+    if (!O.token()) { prikazi(); return; }
+    return O.api('GET', '/api/ja');          // 401/403 otvara obrazac sam (api() -> traziPrijavu)
+  }).catch(function () {});
+
+  function ucitajSdk() {
+    if (window.GenesisAuth) return Promise.resolve();
+    return new Promise(function (res, rej) {
+      var s = document.createElement('script');
+      s.src = konfig.auth_url + '/static/genesis-auth.js';
+      s.onload = res; s.onerror = function () { rej(new Error('Prijavni modul nije dostupan. Provjeri vezu i pokušaj ponovo.')); };
+      document.head.appendChild(s);
+    });
+  }
+
+  $('prijava-gumb').addEventListener('click', function () {
+    var por = $('prijava-poruka');
+    poruka(por, '', '');
+    if (!konfig || !konfig.prijava) { poruka(por, 'greska', 'Prijava nije uključena na poslužitelju.'); return; }
+    zauzet(this, 'Otvaram prijavu…', function () {
+      return ucitajSdk().then(function () { return window.GenesisAuth.login({ origin: konfig.auth_url }); });
+    }).then(function () { window.location.reload(); }, function (e) {
+      poruka(por, 'greska', (e && e.message) || 'Prijava nije uspjela. Pokušaj ponovo.');
+    });
+  });
+
+  $('odjava').addEventListener('click', function () {
+    try { localStorage.removeItem('genesis_auth_v1'); } catch (e) { /* bez pohrane nema se što brisati */ }
+    window.location.reload();
+  });
+}());
