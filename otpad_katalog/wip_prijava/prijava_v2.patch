+"""Prijava za ekran: provjera GenesisLogin sesije preko /api/v1/genesis/auth/me (isti obrazac kao servis qr4d na EU).
+
+Ništa se ne izmišlja: token izdaje fleta (GenesisAuth.login() popup), a ovdje se samo provjerava. Fail-closed (Z53):
+nedostupna provjera = 503 NEPOZNATO, nikad propust. Dopušteni su samo identiteti s popisa (OTPAD_DOZVOLJENI, weise3_id-evi
+odvojeni zarezom): prijava u GenesisLogin sama po sebi ne daje pristup Kelavinim dijelovima.
+Token se ne zapisuje u zapisnik; u memoriji se čuva samo njegov sha256 i to najviše TTL sekundi (pozitivni odgovori).
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import threading
+import time
+import urllib.error
+import urllib.request
+
+from greske import Greska
+
+W3 = re.compile(r"[0-9a-f]{64}")
+
+
+class Prijava:
+    def __init__(self, auth_url: str, dozvoljeni: set[str], ttl: int = 60, rok: int = 6):
+        if not dozvoljeni:
+            raise ValueError("OTPAD_DOZVOLJENI je prazan: prijava bez popisa dopuštenih identiteta nikoga ne bi pustila (ili bi pustila svakoga)")
+        for w in dozvoljeni:
+            if not W3.fullmatch(w):
+                raise ValueError(f"OTPAD_DOZVOLJENI: '{w[:12]}…' nije weise3_id (64 heksadecimalna znaka)")
+        self.auth_url, self.dozvoljeni, self.ttl, self.rok = auth_url.rstrip("/"), set(dozvoljeni), ttl, rok
+        self._kes: dict[str, tuple[str, float]] = {}
+        self._brava = threading.Lock()
+
+    def _me(self, token: str) -> tuple[int, dict]:
+        r = urllib.request.Request(self.auth_url + "/api/v1/genesis/auth/me", headers={"Authorization": "Bearer " + token})
+        try:
+            with urllib.request.urlopen(r, timeout=self.rok) as o:
+                return o.status, json.loads(o.read() or b"{}")
+        except urllib.error.HTTPError as e:
+            return e.code, {}
+
+    def provjeri(self, authorization: str | None) -> str:
+        """-> weise3_id prijavljenog i dopuštenog korisnika, ili Greska (401 prijava, 403 pristup, 503 provjera nedostupna)."""
+        if not authorization or not authorization.lower().startswith("bearer ") or len(authorization) < 16:
+            raise Greska(401, "Za rad s dijelovima prijavi se GenesisLoginom.", prijava=True)
+        token = authorization[7:].strip()
+        kljuc = hashlib.sha256(token.encode()).hexdigest()
+        sada = time.time()
+        with self._brava:
+            k = self._kes.get(kljuc)
+            if k and k[1] > sada:
+                return k[0]
+            for x in [x for x, v in self._kes.items() if v[1] <= sada]:       # čišćenje isteklih
+                del self._kes[x]
+        try:
+            kod, me = self._me(token)
+        except Exception:                                                        # noqa: BLE001
+            raise Greska(503, "Provjera prijave trenutno nije dostupna (NEPOZNATO). Pokušaj ponovo za minutu.")
+        if kod == 401:
+            raise Greska(401, "Prijava je istekla ili nije valjana. Prijavi se GenesisLoginom ponovno.", prijava=True)
+        w = str(me.get("weise3_id") or "")
+        if kod != 200 or not W3.fullmatch(w):
+            raise Greska(503, f"Provjera prijave nije dala identitet (NEPOZNATO, HTTP {kod}).")
+        if w not in self.dozvoljeni:
+            raise Greska(403, "Ovaj GenesisLogin identitet nema pristup evidenciji dijelova. Javi Ivanu.")
+        with self._brava:
+            self._kes[kljuc] = (w, sada + self.ttl)
+        return w
+
+
+def iz_okoline() -> Prijava | None:
+    """OTPAD_PRIJAVA=genesis uključuje prijavu. Zadano je ISKLJUČENA (lokalni razvoj, sluša samo 127.0.0.1) i server to glasno javlja."""
+    import os
+    if os.environ.get("OTPAD_PRIJAVA", "").strip().lower() != "genesis":
+        return None
+    dozvoljeni = {x.strip().lower() for x in os.environ.get("OTPAD_DOZVOLJENI", "").split(",") if x.strip()}
+    return Prijava(os.environ.get("OTPAD_AUTH_URL", "https://genesis.limit-connect.com"), dozvoljeni)
