[Unit]
Description=Fenix MCP Server for Claude
After=network.target gunicorn-fina.service

[Service]
User=root
WorkingDirectory=/var/www/fina-connect
ExecStartPre=/bin/bash -c 'fuser -k 8765/tcp 2>/dev/null || true; sleep 1'
ExecStart=/var/www/fina-connect/venv/bin/python /var/www/fina-connect/mcp_server.py
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=15
Environment=DJANGO_SETTINGS_MODULE=core.settings
Environment=PYTHONPATH=/var/www/fina-connect

[Install]
WantedBy=multi-user.target
