[Unit]
Description=Daphne ASGI server for fina-connect WebSocket
After=network.target redis.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/fina-connect
ExecStart=/var/www/fina-connect/venv/bin/daphne -b 127.0.0.1 -p 8001 core.asgi:application
Restart=always
RestartSec=5
Environment="DJANGO_SETTINGS_MODULE=core.settings"

[Install]
WantedBy=multi-user.target
