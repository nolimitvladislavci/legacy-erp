"""Dev-only: remote exec za Claude session. OBRISATI kad nije potrebno!"""
import subprocess, json, os
from django.http import JsonResponse
from django.views.decorators.csrf import csrf_exempt
from django.views.decorators.http import require_POST

SECRET = os.environ.get('DEV_API_TOKEN', '')

def _check(request):
    if not SECRET:
        return JsonResponse({'error': 'DEV_API_TOKEN not set'}, status=503)


    # ONLY Bearer — X-Dev-Token blokiran
    auth = request.headers.get('Authorization', '')
    token = auth[7:] if auth.startswith('Bearer ') else ''
    if token != SECRET:
        return JsonResponse({'error': 'forbidden'}, status=403)
    return None

@csrf_exempt
@require_POST
def remote_exec(request):
    err = _check(request)
    if err: return err
    body = json.loads(request.body)
    cmd = body.get('cmd', '')
    if not cmd:
        return JsonResponse({'error': 'no cmd'})
    try:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                                timeout=30, cwd='/var/www/fina-connect')
        return JsonResponse({'stdout': result.stdout[:50000],
                             'stderr': result.stderr[:5000],
                             'code': result.returncode})
    except subprocess.TimeoutExpired:
        return JsonResponse({'error': 'timeout'})

@csrf_exempt
@require_POST
def remote_read(request):
    err = _check(request)
    if err: return err
    body = json.loads(request.body)
    path = body.get('path', '')
    if not path or '..' in path:
        return JsonResponse({'error': 'invalid path'})
    full = os.path.join('/var/www/fina-connect', path)
    try:
        with open(full) as f:
            return JsonResponse({'content': f.read()[:100000], 'path': path})
    except Exception as e:
        return JsonResponse({'error': str(e)})

@csrf_exempt
@require_POST
def remote_write(request):
    err = _check(request)
    if err: return err
    body = json.loads(request.body)
    path = body.get('path', '')
    content = body.get('content', '')
    if not path or '..' in path:
        return JsonResponse({'error': 'invalid path'})
    full = os.path.join('/var/www/fina-connect', path)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    try:
        with open(full, 'w') as f:
            f.write(content)
        return JsonResponse({'ok': True, 'path': path})
    except Exception as e:
        return JsonResponse({'error': str(e)})
